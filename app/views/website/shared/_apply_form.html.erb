<%# locals: () -%>
<%# The application, from Forms › application. %>
<% form = gl_form(:application) %>
<% if form %>
  <form id="apply-form" data-audit-form data-form-slug="application" method="post" action="<%= api_form_submissions_path(form_slug: form.slug) %>" class="form-card" novalidate>
    <div class="form-head"><h3 class="form-title">Apply</h3><p class="form-sub">One specific thing you built or ran, and what happened. A person reads it.</p></div>
    <%= gl_control(form, :role, id: "apply-role", select: {prompt: "Choose one"}) %>
    <div class="field-row">
      <%= gl_control(form, :name, id: "apply-name", autocomplete: "name") %>
      <%= gl_control(form, :email, id: "apply-email", autocomplete: "email", inputmode: "email", data: {email: true}) %>
    </div>
    <%= gl_control(form, :links, id: "apply-links", hint: "(GitHub, portfolio, LinkedIn, a site you run)", inputmode: "url") %>
    <%= gl_control(form, :message, id: "apply-message", rows: 5) %>
    <%= render "website/shared/form_tail", form:, source: "golumin-careers", cta: "apply", label: form.submit_label %>
    <p class="form-fine">Or email <a href="mailto:<%= gl_email %>"><%= gl_email %></a> with a CV attached. <a href="/privacy">Privacy</a></p>
  </form>
<% end %>
