<%# locals: () -%>
<%# The footer global: the blurb under the logo and the Google Partner badge, its columns (Services lists the services collection after its own links), then the copyright line with the legal pages. %>
<% footer = gl_global(:footer) %>
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <%= gl_logo(loading: :lazy) %>
        <% if footer.blurb.present? %><p><%= website_plain_text(footer.blurb) %></p><% end %>
        <a class="footer-partner" href="https://www.google.com/partners/agency?id=4365181293" rel="noopener" target="_blank">
          <%= image_tag gl_asset_path("google-partner.svg"), alt: "Google Partner", width: 44, height: 42, loading: :lazy %>
          <span>Certified Google Partner</span>
        </a>
      </div>
      <% footer.columns.each do |column| %>
        <% links = column.items.filter_map { |i| (h = gl_href(i.link)) && [i.label, h] } %>
        <% links += gl_services.map { |s| [website_fields(s).nav.presence || s.title, website_path(s)] } if column.children_from == "services" %>
        <nav class="footer-col" aria-label="<%= column.heading %>">
          <div class="footer-head"><%= column.heading %></div>
          <% links.each do |label, href| %>
            <a href="<%= href %>"<% if gl_external?(href) %> rel="nofollow"<% end %>><%= label %></a>
          <% end %>
        </nav>
      <% end %>
    </div>
    <div class="footer-bottom">
      <span>&copy; <%= gl_year %> <%= footer.copyright.presence || gl_name %><% if footer.tagline.present? %> · <%= footer.tagline %><% end %></span>
      <span class="footer-links"><a href="/privacy">Privacy</a><a href="/terms">Terms</a></span>
    </div>
  </div>
</footer>
