<%# locals: () -%>
<%# The footer global (Footer.astro): the blurb under the logo, its columns (Services lists the services collection after its own links), the copyright and the line about who signs. %>
<% footer = gl_global(:footer) %>
<footer class="rule-t">
  <div class="mx-auto max-w-6xl px-5 py-12 md:px-8 md:py-16">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div>
        <%= gl_logo(class: "h-7 w-auto", loading: :lazy) %>
        <% if footer.blurb.present? %>
          <p class="mt-4 max-w-xs text-[15px] leading-snug text-text-subtle"><%= website_plain_text(footer.blurb) %></p>
        <% end %>
      </div>
      <% footer.columns.each do |column| %>
        <% links = column.items.filter_map { |i| (h = gl_href(i.link)) && [i.label, h] } %>
        <% links += gl_services.map { |s| [website_fields(s).nav, website_path(s)] } if column.children_from == "services" %>
        <nav aria-label="<%= column.heading %>">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted"><%= column.heading %></p>
          <ul class="mt-4 space-y-2">
            <% links.each do |label, href| %>
              <li><a href="<%= href %>" class="text-[15px] text-text-subtle transition-colors hover:text-text"<% if gl_external?(href) %> rel="nofollow"<% end %>><%= label %></a></li>
            <% end %>
          </ul>
        </nav>
      <% end %>
    </div>
    <div class="mt-12 flex flex-col gap-3 border-t border-border pt-6 font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted md:flex-row md:items-center md:justify-between">
      <span>&copy; <%= gl_year %> <%= footer.copyright.presence || gl_name %></span>
      <span class="normal-case tracking-normal"><%= footer.tagline %></span>
    </div>
  </div>
</footer>
