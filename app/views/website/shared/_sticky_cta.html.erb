<%# locals: (label:) -%>
<%# The phone's audit bar (StickyCta.astro): it rises once the page's first audit form has scrolled away, and drops while one is in view (forms.js). %>
<div id="sticky-cta" class="fixed inset-x-0 bottom-0 z-50 translate-y-full border-t-2 border-text bg-bg/95 p-3 backdrop-blur [transition:transform_.6s_var(--spring)] md:hidden" inert>
  <a href="#audit" data-cta="sticky" class="flex h-12 w-full items-center justify-center rounded-md bg-text text-base font-semibold text-bg"><%= label %></a>
</div>
