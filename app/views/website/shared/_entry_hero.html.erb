<%# locals: (crumb_label:, crumb_href:, eyebrow:, heading:, lede:, chips: [], after: nil) -%>
<%# An entry's opening under the light, with its breadcrumb: back to the listing, the entry's name, its headline and standfirst. %>
<section class="page-hero is-night">
  <%= render "website/shared/scene" %>
  <div class="container">
    <div class="page-hero-inner">
      <p class="breadcrumb"><a href="<%= crumb_href %>"><%= crumb_label %></a><span aria-hidden="true">/</span><span><%= eyebrow %></span></p>
      <h1 class="h-hero"><%= gl_heading(heading) %></h1>
      <% if lede.present? %><p class="lede"><%= lede %></p><% end %>
      <% if chips.any? %><div class="chips"><% chips.each do |chip| %><span class="chip"><%= chip %></span><% end %></div><% end %>
    </div>
    <%= after %>
  </div>
</section>
