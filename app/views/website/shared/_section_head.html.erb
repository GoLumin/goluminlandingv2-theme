<%# locals: (data:, size: "lg", klass: "max-w-3xl") -%>
<%# A section's eyebrow and heading, as most sections open. %>
<div class="<%= klass %>">
  <%= gl_eyebrow(data.eyebrow, data.eyebrow_n) %>
  <% if data.heading.present? %>
    <h2 class="<%= class_names("reveal display", "display-md": size == "md", "display-lg": size != "md") %>"><%= gl_heading(data.heading) %></h2>
  <% end %>
</div>
