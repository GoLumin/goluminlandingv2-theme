<%# locals: (klass: "reveal mt-8") -%>
<%# The Google Partner badge and its lines (the Ad landing pages global's credentials). %>
<% cred = gl_global(:ad_landing).credentials %>
<div class="<%= klass %> flex items-center gap-4 border-2 border-text bg-surface px-4 py-3 sm:inline-flex">
  <%= gl_image cred.badge, alt: "Google Partner", sizes: "5rem", class: "h-14 w-auto shrink-0", loading: :eager %>
  <div>
    <p class="text-[15px] font-bold leading-tight tracking-tight"><%= cred.title %></p>
    <% cred.lines.each do |line| %><p class="mt-0.5 text-[13px] leading-snug text-text-subtle"><%= line %></p><% end %>
  </div>
</div>
