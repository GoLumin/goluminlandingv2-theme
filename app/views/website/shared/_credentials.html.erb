<%# locals: () -%>
<%# The Google Partner badge and the lines beside it (the Ad landing pages global's credentials). %>
<% c = gl_global(:ad_landing).credentials %>
<div class="hero-proof">
  <div class="proof"><%= image_tag gl_asset_path("google-partner.svg"), alt: "", width: 34, height: 33 %><span><strong><%= c.title %></strong></span></div>
  <% c.lines.each do |line| %><div class="proof"><span><%= gl_inline(line) %></span></div><% end %>
</div>
