<%# locals: (phone_label:, phone_href:, cta: "lp", alt: "Lumin", line: nil) -%>
<%# A landing page's slim bar: the logo (home), a line of credentials, and the phone. No nav: the ways off the page are the form and the phone. %>
<header class="nav nav-lp" data-nav>
  <div class="container nav-inner">
    <a class="nav-logo" href="/" aria-label="<%= gl_name %> home"><%= gl_logo(alt:) %></a>
    <% if line.present? %><div class="nav-lp-tag"><%= line %></div><% end %>
    <div class="nav-actions">
      <span class="nav-lp-label">Talk with a real person</span>
      <a class="btn btn-dark btn-sm" href="<%= phone_href %>" data-cta="<%= cta %>-header-phone"><%= phone_label %></a>
    </div>
  </div>
</header>
