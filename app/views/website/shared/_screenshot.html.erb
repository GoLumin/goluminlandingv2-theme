<%# locals: (image:, caption: nil, eager: false) -%>
<%# A product screenshot in a browser frame (ui/Screenshot.astro). Nothing without the image. %>
<% img = gl_image(image, sizes: "(min-width: 72rem) 36rem, (min-width: 768px) 50vw, 100vw", class: "block w-full h-auto", loading: eager ? :eager : :lazy) %>
<% if img %>
  <figure class="overflow-hidden rounded-lg border border-border bg-surface shadow-[0_30px_70px_-30px_rgb(0_0_0/0.28)]">
    <div class="flex items-center gap-1.5 border-b border-border-light bg-bg-subtle px-3 py-2">
      <span class="h-2.5 w-2.5 rounded-full bg-border"></span><span class="h-2.5 w-2.5 rounded-full bg-border"></span><span class="h-2.5 w-2.5 rounded-full bg-border"></span>
    </div>
    <%= img %>
    <% if caption.present? %><figcaption class="border-t border-border-light px-4 py-2 font-mono text-[11px] text-text-muted"><%= caption %></figcaption><% end %>
  </figure>
<% end %>
