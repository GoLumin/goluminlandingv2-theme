<%# locals: (quote:, link: true) -%>
<%# A client's quote, set large, with the outcome beside it as a figure. %>
<% q = website_fields(quote) %>
<%= gl_section(tone: "ink", klass: "has-photo") do %>
  <%= render "website/shared/scene", key: "quote", night: true %>
  <div class="quote-grid<%= " is-alone" if q.result_figure.blank? %>">
    <blockquote class="reveal">
      <p class="quote-text">“<%= q.quote %>”</p>
      <p class="quote-by"><strong><%= quote.title %></strong> · <%= [q.role, q.company].compact_blank.join(", ") %></p>
    </blockquote>
    <% if q.result_figure.present? %>
      <div class="quote-stat reveal" style="--i:1">
        <span class="num"><%= q.result_figure %></span>
        <p><%= q.result_label.to_s.upcase_first %></p>
        <% if link && q.case_study.present? && gl_case(q.case_study) %><a href="/work/<%= q.case_study %>" data-cta="testimonial" class="btn-link">Read the case study <span class="arrow" aria-hidden="true">→</span></a><% end %>
      </div>
    <% end %>
  </div>
<% end %>
