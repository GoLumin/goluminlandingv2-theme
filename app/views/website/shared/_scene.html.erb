<%# locals: (key: nil, night: false) -%>
<%# What sits behind a night hero or a dark section, in this order: the branded photograph (the url inline on the element, so it resolves against the page), the aurora's three drifting lights, the moving tint, and the scrim, a steady dark pool under the copy so the type reads while the light moves elsewhere. No glows: the light in the photographs is the play. %>
<% url, position = gl_brand_photo(key || request.path) %>
<div class="<%= night ? "night-photo" : "hero-photo" %>" aria-hidden="true"><i style="background-image:url(<%= url %>)<% if position %>;background-position:<%= position %><% end %>"></i></div>
<div class="aurora" aria-hidden="true"><i class="a1"></i><i class="a2"></i><i class="a3"></i></div>
<div class="tint" aria-hidden="true"></div>
<div class="scrim" aria-hidden="true"></div>
