<%# locals: (link_label: "What's included →", cta: "lp-banner", hide_link_on_phone: false) -%>
<%# The offer, first thing on the page (AdGroupLanding.astro): the Ad landing pages global's free landing page. %>
<% offer = gl_global(:ad_landing).offer %>
<div class="brand-gradient-bg text-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-3 gap-y-1 px-5 py-2.5 text-center md:px-8">
    <span class="breathe text-[15px]" aria-hidden="true">◆</span>
    <p class="text-[14px] font-semibold leading-snug md:text-[15px]"><%= offer.label %> &middot; <%= offer.value %> value, yours to keep</p>
    <a href="#offer" data-cta="<%= cta %>" class="<%= class_names("text-[13px] font-semibold underline decoration-white/50 decoration-2 underline-offset-[5px] transition-colors hover:decoration-white", "hidden sm:inline": hide_link_on_phone) %>"><%= link_label %></a>
  </div>
</div>
