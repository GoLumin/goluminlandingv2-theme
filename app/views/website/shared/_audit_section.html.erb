<%# locals: (heading:, blurb:, bullets:, audit_type: nil, eyebrow: "Free marketing plan", lock_type: false, submit_label: nil, note: nil, prefix: "footer", tone: "subtle") -%>
<%# The plan section: the pitch and its bullets on the left, the form on the right, at #audit, where every "Get my free plan" button lands. %>
<%= gl_section(tone:, id: "audit") do %>
  <div class="cta-grid">
    <div class="reveal">
      <%= gl_eyebrow(eyebrow) %>
      <h2 class="h-2"><%= gl_heading(heading) %></h2>
      <% if blurb.present? %><p class="lede"><%= blurb %></p><% end %>
      <% if Array(bullets).any? %>
        <ul class="check-list">
          <% bullets.each do |bullet| %><li><%= bullet %></li><% end %>
        </ul>
      <% end %>
      <p class="note">Or call us: <a href="<%= gl_tel %>" data-cta="audit-section-phone"><%= gl_phone %></a></p>
    </div>
    <div class="reveal" style="--i:1">
      <%= render "website/shared/audit_form", prefix:, audit_type:, lock_type:, submit_label:, note: %>
    </div>
  </div>
<% end %>
