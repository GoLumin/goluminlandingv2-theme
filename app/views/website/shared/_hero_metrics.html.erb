<%# locals: (metrics:, as_of:) -%>
<%# The hero's proof line (HeroMetrics.astro): the proof global's figures punched in one at a time (metrics.js); a static list for screen readers and reduced motion. %>
<% shown = metrics.select { |m| m.value.to_s.strip.present? } %>
<% fmt = ->(m) { "#{m.prefix}#{number_with_delimiter(number_with_precision(m.value.to_f, precision: m.decimals.to_i))}#{m.suffix}" } %>
<div class="reveal" data-hero-metrics>
  <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted">Across the accounts we run<% if as_of.present? %><span> · <%= as_of %></span><% end %></p>
  <ul class="metrics-static sr-only">
    <% shown.each do |m| %>
      <li>
        <span class="display block text-[34px] leading-none tabular-nums"><%= fmt.(m) %></span>
        <span class="mt-1 block text-[14px] leading-snug text-text-subtle"><%= m.label %></span>
      </li>
    <% end %>
  </ul>
  <div class="metrics-ticker" aria-hidden="true">
    <div class="relative mt-2 h-[64px] overflow-hidden sm:h-[72px]">
      <% shown.each_with_index do |m, i| %>
        <div class="metric absolute inset-0 flex items-center gap-4" style="<%= "opacity:0" unless i.zero? %>" data-value="<%= m.value %>" data-decimals="<%= m.decimals.to_i %>" data-prefix="<%= m.prefix %>" data-suffix="<%= m.suffix %>">
          <span data-n class="display brand-gradient-text inline-block origin-left text-[46px] leading-none tabular-nums sm:text-[56px]"><%= fmt.(m) %></span>
          <span class="max-w-[17ch] text-[15px] font-medium leading-tight text-text-subtle sm:text-base"><%= m.label %></span>
        </div>
      <% end %>
    </div>
    <% if shown.size > 1 %>
      <div class="mt-3 flex gap-1.5">
        <% shown.each do %><span class="relative h-[3px] w-8 overflow-hidden bg-border"><i data-seg class="absolute inset-y-0 left-0 w-0 bg-text"></i></span><% end %>
      </div>
    <% end %>
  </div>
</div>
