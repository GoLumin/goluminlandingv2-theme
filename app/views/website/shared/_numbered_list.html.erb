<%# locals: (eyebrow:, eyebrow_n: nil, heading:, items:, body: nil, quoted: false, marker: "number", ctas: []) -%>
<%# A heading held on the left, a list of cards on the right: items are [title, body, tag]. marker "tag" shows each tag as the card's kicker. %>
<div class="plan-grid">
  <div class="reveal">
    <%= gl_eyebrow(eyebrow, eyebrow_n) %>
    <h2 class="h-2"><%= gl_heading(heading) %></h2>
    <% if body.present? %><p class="lede"><%= body %></p><% end %>
    <% if ctas.any? %><div class="btn-row"><%= gl_ctas(ctas) %></div><% end %>
  </div>
  <div class="plan-list reveal" style="--i:1">
    <% items.each do |title, text, label| %>
      <div class="plan-item">
        <% if marker == "tag" && label.present? %><p class="step-when"><%= label %></p><% end %>
        <% if title.present? %><h3 class="h-4"><%= quoted ? "“#{title}”" : title %></h3><% end %>
        <% if text.present? %><p><%= text %></p><% end %>
      </div>
    <% end %>
  </div>
</div>
