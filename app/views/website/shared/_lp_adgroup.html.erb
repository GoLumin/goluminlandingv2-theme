<%# locals: (entry:, lp:) -%>
<%# One Google Ads ad group's page (AdGroupLanding.astro). The argument, in order: you already pay for the click; where it lands decides what it costs; we build that page free; the proof; how the account is run; what it costs to find out (nothing). The shared evidence is the Ad landing pages global's. %>
<% ad = gl_global(:ad_landing) %>
<% cta = ->(n) { "lp-#{entry.slug}-#{n}" } %>
<% studies = gl_cases(lp.cases) %>
<% lead, *rest = studies %>
<% lead_f = lead && website_fields(lead) %>
<% outcomes = gl_work.select { |w| website_fields(w).outcome.stat.present? }.first(4) %>
<% gallery = %w[behnke-logistics kalamazoo-mortgage biofuse inbox-portable-storage mulebox foxbox-moves white-and-white wise-insurance the-foundry shine-learning-alliance].filter_map { gl_case(it) } %>
<% gallery += gl_work - gallery %>
<% scale = ad.benchmarks.our_high.to_f.nonzero? || 1 %>
<% clicks = ad.click_math.clicks.to_i %>
<% leads = ->(rate) { (clicks * rate.to_f / 100).round } %>
<% multiple = ->(n) { (n.to_f / ad.benchmarks.landing_page.to_f).round(1).to_s.delete_suffix(".0") } %>
<% button = ->(n) { tag.a(lp.submit_label, href: "#lp-form", data: {cta: cta.(n)}, class: "inline-flex h-14 items-center justify-center rounded-md bg-text px-7 text-base font-semibold text-bg transition-colors hover:bg-primary") } %>
<% team = gl_team %>
<% content_for :header do %>
  <a href="#lp-form" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-text focus:px-4 focus:py-2 focus:text-bg">Skip to the form</a>
  <%= render "website/shared/landing_header", phone_label: gl_phone, phone_href: gl_tel, cta_label: "Get my free plan", cta: "lp-#{entry.slug}", offer: true, alt: "GoLumin" %>
<% end %>

<% extra = capture do %>
  <%= render "website/shared/credentials" %>
  <% if team.size >= 2 %>
    <div class="reveal mt-6 flex items-center gap-3">
      <div class="flex -space-x-2"><% team.each do |person| %><%= gl_image website_fields(person).photo, alt: person.title, sizes: "3rem", class: "h-11 w-11 rounded-full border-2 border-text object-cover" %><% end %></div>
      <p class="text-[13.5px] leading-snug text-text-subtle">You'll talk with <span class="font-semibold text-text"><%= team[0].title %></span> and <span class="font-semibold text-text"><%= team[1].title %></span>. <span class="text-text-muted">GoLumin's founders, not a call centre.</span></p>
    </div>
  <% end %>
<% end %>
<%= render "website/shared/lp_hero", entry:, lp:, extra:, top: "md:pt-14",
  form: render("website/shared/audit_form", prefix: "lp-#{entry.slug}-hero", compact: true, cta: cta.("hero-form"), audit_type: lp.audit_type, lock_type: true, submit_label: lp.submit_label,
    kicker: "Free marketing plan", heading: "Built on your account. Yours to keep.", blurb: ad.plan.effort, note: ad.plan.refrain) %>

<section class="rule-t rule-b bg-bg-subtle">
  <div class="mx-auto grid max-w-6xl gap-px bg-border sm:grid-cols-2 lg:grid-cols-4" data-stagger>
    <% outcomes.each do |study| %>
      <% o = website_fields(study).outcome %>
      <div class="reveal bg-bg-subtle px-5 py-7 md:px-6">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted"><%= study.title %></p>
        <p class="mt-3 text-[26px] font-bold leading-none tracking-[-0.04em] tabular"><%= o.stat %></p>
        <p class="mt-2.5 text-[14px] leading-snug text-text-subtle"><%= o.label %></p>
        <% if o.sub.present? %><p class="mt-1 font-mono text-[10.5px] uppercase tracking-[0.1em] text-text-muted"><%= o.sub %></p><% end %>
      </div>
    <% end %>
  </div>
</section>

<% if lp.show_reviewer %>
  <%= gl_section(rule: false) do %>
    <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
      <div>
        <%= gl_eyebrow("The reviewer", "Who reads it") %>
        <h2 class="reveal display display-md"><%= ad.reviewer.h %></h2>
        <p class="reveal mt-6 text-lg leading-snug text-text-subtle"><%= ad.reviewer.sub %></p>
        <div class="reveal mt-8 flex items-center gap-4 border-2 border-text bg-surface px-5 py-4 shadow-[6px_6px_0_0_var(--color-text)]">
          <%= gl_image ad.credentials.badge, alt: "Google Partner", sizes: "5rem", class: "h-16 w-auto shrink-0" %>
          <div>
            <p class="text-[15px] font-bold leading-tight tracking-tight"><%= ad.credentials.title %></p>
            <p class="mt-0.5 text-[13px] leading-snug text-text-subtle">10+ years in paid search</p>
            <p class="mt-0.5 text-[13px] leading-snug text-text-subtle"><%= ad.credentials.lines.first %></p>
          </div>
        </div>
      </div>
      <ol class="rule-t" data-stagger>
        <% ad.reviewer.points.each_with_index do |point, i| %>
          <li class="reveal grid grid-cols-[2.5rem_1fr] items-baseline gap-3 border-b border-border py-5"><span class="font-mono text-[12px] text-text-muted"><%= gl_n(i) %></span><div><h3 class="text-lg font-semibold tracking-tight"><%= point.t %></h3><p class="mt-1.5 text-[15px] leading-snug text-text-subtle"><%= point.d %></p></div></li>
        <% end %>
      </ol>
    </div>
  <% end %>
<% end %>

<%= gl_section(rule: false) do %>
  <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <%= gl_eyebrow(ad.plan["name"], "No charge") %>
      <h2 class="reveal display display-md"><%= ad.plan.headline %></h2>
      <p class="reveal mt-6 text-lg leading-snug text-text-subtle"><%= ad.plan.sub %></p>
      <div class="reveal mt-8 border-l-2 border-signal bg-bg-subtle px-5 py-4">
        <p class="text-[15px] font-semibold leading-snug"><%= ad.plan.refrain %></p>
        <p class="mt-1.5 text-[14px] leading-snug text-text-subtle">No contract to sign for it, and no obligation at the end of it. If we are not the right fit we will say so on the call.</p>
      </div>
      <div class="reveal mt-8"><%= button.("plan") %></div>
    </div>
    <ul class="rule-t" data-stagger>
      <% ad.plan.keep.each do |item| %>
        <li class="reveal grid grid-cols-[1.75rem_1fr] items-start gap-3 border-b border-border py-5">
          <%= gl_check("mt-[3px] shrink-0 text-success", size: 20) %>
          <div><h3 class="text-lg font-semibold tracking-tight"><%= item.t %></h3><p class="mt-1.5 text-[15px] leading-snug text-text-subtle"><%= item.d %></p></div>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= gl_section(rule: false) do %>
  <div class="max-w-3xl">
    <%= gl_eyebrow("Where your clicks go", "The maths") %>
    <h2 class="reveal display display-lg">Same clicks. Same budget. <span class="mark">Two to four times the leads.</span></h2>
    <p class="reveal mt-6 text-lg leading-snug text-text-subtle">A click costs the same whatever it lands on. What changes is how many of them turn into somebody you can call back. That number is set almost entirely by the page, and most businesses send paid traffic to a homepage that was never built to take a lead.</p>
  </div>
  <div class="reveal mt-12 border-2 border-text bg-surface">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b-2 border-text px-5 py-4 md:px-7">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted">Out of <%= number_with_delimiter(clicks) %> ad clicks</p>
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted">Leads, as a share of clicks</p>
    </div>
    <ol class="divide-y divide-border">
      <% ad.click_math.rows.each do |r| %>
        <% brand = r.tone == "brand" %>
        <li class="px-5 py-6 md:px-7">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <p class="<%= class_names("text-[17px] leading-tight tracking-tight", "font-bold": brand, "font-semibold text-text-subtle": !brand) %>"><%= r.label %></p>
            <p class="<%= class_names("font-mono text-[15px] font-semibold tabular", "text-primary": brand, "text-text-muted": !brand) %>"><%= r.hi.present? ? "#{r.rate}–#{r.hi}%" : "#{r.rate}%" %></p>
          </div>
          <div class="mt-3 h-8 w-full border border-border-light bg-bg-subtle">
            <% if r.hi.present? %>
              <div class="flex h-full" style="width:<%= (r.hi.to_f / scale * 100).round(3) %>%">
                <div class="h-full shrink-0 brand-gradient-bg" style="width:<%= (r.rate.to_f / r.hi.to_f * 100).round(3) %>%"></div>
                <div class="h-full grow" style="background-image:repeating-linear-gradient(135deg,var(--color-primary) 0 5px,transparent 5px 10px);opacity:.55"></div>
              </div>
            <% else %>
              <div class="h-full bg-text-muted" style="width:<%= (r.rate.to_f / scale * 100).round(3) %>%"></div>
            <% end %>
          </div>
          <p class="mt-2.5 flex flex-wrap items-baseline gap-x-2 text-[14px] leading-snug">
            <span class="<%= class_names("font-mono font-semibold tabular", "text-text": brand, "text-text-subtle": !brand) %>"><%= r.hi.present? ? "#{leads.(r.rate)}–#{leads.(r.hi)}" : leads.(r.rate) %> leads</span>
            <span class="text-text-muted">· <%= r.note %></span>
          </p>
        </li>
      <% end %>
    </ol>
    <div class="border-t-2 border-text bg-bg-subtle px-5 py-4 md:px-7">
      <p class="text-[13px] leading-relaxed text-text-subtle">
        <span class="font-semibold text-text">Where these come from.</span>
        The typical landing page figure is the median of 41,000 pages in the <span class="font-semibold"><%= ad.benchmarks.landing_page_source.to_s.split(" — ").first %></span>. The Google Ads average is the all-industries figure from the <span class="font-semibold"><%= ad.benchmarks.google_ads_source.to_s.split(",").first %></span>.
        <%= ad.benchmarks.our_method %>
      </p>
    </div>
  </div>
  <p class="reveal mt-8 max-w-3xl text-lg leading-snug text-text-subtle">
    At the same cost per click, that difference is <span class="font-semibold text-text"><%= multiple.(ad.benchmarks.our_low) %> to <%= multiple.(ad.benchmarks.our_high) %> times the leads</span> from a budget you are already spending. It is the cheapest thing you can fix in a Google Ads account, and it is the thing almost nobody fixes — which is why we stopped charging for it.
  </p>
<% end %>

<%= gl_section(tone: "subtle", id: "offer", klass: "scroll-mt-16") do %>
  <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <%= gl_eyebrow("The offer", "Included") %>
      <h2 class="reveal display display-md"><%= ad.offer.headline %></h2>
      <p class="reveal mt-6 text-lg leading-snug text-text-subtle"><%= ad.offer.sub %></p>
      <div class="reveal mt-8 inline-flex items-baseline gap-3 border-2 border-text bg-surface px-5 py-4 shadow-[6px_6px_0_0_var(--color-text)]">
        <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted">Build value</span>
        <span class="text-[30px] font-bold leading-none tracking-[-0.045em] tabular line-through decoration-[2.5px] decoration-danger"><%= ad.offer.value %></span>
        <span class="text-[17px] font-bold text-primary">$0</span>
      </div>
      <p class="reveal mt-6 text-[14px] leading-snug text-text-muted">One page per campaign to start. More as the account earns them — each one written for a different search, because that is what makes them work.</p>
    </div>
    <ol class="rule-t" data-stagger>
      <% ad.offer.includes.each_with_index do |item, i| %>
        <li class="reveal grid grid-cols-[2.5rem_1fr] items-baseline gap-3 border-b border-border py-5"><span class="font-mono text-[12px] text-text-muted"><%= gl_n(i) %></span><div><h3 class="text-lg font-semibold tracking-tight"><%= item.t %></h3><p class="mt-1.5 text-[15px] leading-snug text-text-subtle"><%= item.d %></p></div></li>
      <% end %>
      <li class="reveal pt-7"><%= button.("offer") %></li>
    </ol>
  </div>
<% end %>

<%= render "website/shared/client_logos", label: "Sites and campaigns we run today", linked: false %>

<%= gl_section(tone: "subtle") do %>
  <div class="max-w-3xl">
    <%= gl_eyebrow("Built by us, live now", "Our work") %>
    <h2 class="reveal display display-lg">The pages your ads would land on. <span class="mark">All of these are live.</span></h2>
    <p class="reveal mt-6 text-lg leading-snug text-text-subtle">Landing pages, quote flows and full sites we designed, built and host — every one of them taking leads for a client right now. Open any address below and check it. The page we build for you is made the same way, and it is included.</p>
  </div>
  <div class="mt-12 grid gap-6 sm:grid-cols-2" data-stagger>
    <% gallery.each do |study| %>
      <% c = website_fields(study) %>
      <figure class="reveal overflow-hidden rounded-lg border-2 border-text bg-surface">
        <div class="flex items-center gap-1.5 border-b-2 border-text bg-bg-subtle px-3 py-2">
          <span class="h-2.5 w-2.5 rounded-full bg-border"></span><span class="h-2.5 w-2.5 rounded-full bg-border"></span><span class="h-2.5 w-2.5 rounded-full bg-border"></span>
          <span class="ml-2 truncate font-mono text-[11px] text-text-muted"><%= c.host %></span>
        </div>
        <%= gl_image c.screenshot, alt: "The #{study.title} site, built by GoLumin", sizes: "(min-width: 72rem) 34rem, (min-width: 640px) 50vw, 100vw", class: "block aspect-[16/10] w-full object-cover object-top" %>
        <figcaption class="border-t-2 border-text p-4">
          <p class="text-[15px] font-bold tracking-tight"><%= study.title %></p>
          <p class="mt-0.5 font-mono text-[10.5px] uppercase tracking-[0.12em] text-text-muted"><%= c.vertical %> · <%= c.platform %></p>
          <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
            <% c.figures.each do |f| %><li class="text-[13px] leading-snug"><span class="font-mono font-semibold tabular text-text"><%= f.n %></span> <span class="text-text-subtle"><%= f.l %></span></li><% end %>
          </ul>
        </figcaption>
      </figure>
    <% end %>
  </div>
  <p class="reveal mt-8 text-[14px] leading-snug text-text-muted">Every figure above is counted on the live site or in its sitemap, captured 10 September 2026. Screenshots are the real pages, not mockups.</p>
  <div class="reveal mt-8"><%= button.("gallery") %></div>
<% end %>

<%= gl_section do %>
  <div class="max-w-3xl">
    <%= gl_eyebrow("Accounts we run", "Proof") %>
    <h2 class="reveal display display-lg"><%= lp.cases_heading %></h2>
    <p class="reveal mt-6 text-lg leading-snug text-text-subtle">Every figure below is counted in the client's own Google Ads account or their GA4, and each one says which. Where a number is a client's to release we asked first, and we publish the baseline, the timeframe and the method next to it.</p>
  </div>
  <% if lead %>
    <article class="reveal mt-12 border-2 border-text bg-surface">
      <div class="grid lg:grid-cols-[1.1fr_0.9fr]">
        <div class="border-b-2 border-text p-6 md:p-9 lg:border-b-0 lg:border-r-2">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted">Case study · <%= lead.title %> · <%= lead_f.vertical %></p>
          <h3 class="mt-4 display display-md"><%= lead_f.h %></h3>
          <dl class="mt-7 space-y-5">
            <div><dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-danger">The problem</dt><dd class="mt-1.5 text-[15.5px] leading-snug text-text-subtle"><%= lead_f.story.problem %></dd></div>
            <div><dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-signal">What we did</dt><dd class="mt-1.5 text-[15.5px] leading-snug text-text-subtle"><%= lead_f.story.did %></dd></div>
            <div><dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-success">What happened</dt><dd class="mt-1.5 text-[15.5px] leading-snug text-text-subtle"><%= lead_f.story.happened %></dd></div>
          </dl>
        </div>
        <div class="flex flex-col">
          <div class="<%= class_names("bg-bg-subtle px-6 py-8 text-center md:px-8", "border-b-2 border-text": lead_f.stat_band.any?, "flex grow flex-col justify-center": lead_f.stat_band.empty?) %>">
            <p class="figure figure-md brand-gradient-text"><%= lead_f.outcome.stat %></p>
            <p class="mt-4 text-[15px] font-semibold leading-snug"><%= lead_f.outcome.label %></p>
            <% if lead_f.outcome.sub.present? %><p class="mt-1 text-[14px] text-text-subtle"><%= lead_f.outcome.sub %></p><% end %>
          </div>
          <% if lead_f.stat_band.any? %>
            <ul class="grid grow gap-px bg-border sm:grid-cols-2 lg:grid-cols-1">
              <% lead_f.stat_band.first(3).each do |s| %><li class="bg-surface px-6 py-4 md:px-8"><p class="font-mono text-[17px] font-semibold tabular"><%= s.n %></p><p class="mt-1 text-[13.5px] leading-snug text-text-subtle"><%= s.l %></p></li><% end %>
            </ul>
          <% end %>
        </div>
      </div>
      <p class="border-t-2 border-text bg-bg-subtle px-6 py-3 font-mono text-[11px] leading-relaxed text-text-muted md:px-9"><%= lead_f.host %> · figures counted in the client's own account</p>
    </article>
  <% end %>
  <div class="mt-8 grid gap-6 md:grid-cols-3" data-stagger>
    <% rest.each do |study| %>
      <% c = website_fields(study) %>
      <article class="reveal flex flex-col border-2 border-text bg-surface">
        <%= gl_image c.screenshot, alt: "The #{study.title} site", sizes: "(min-width: 768px) 33vw, 100vw", class: "block aspect-[16/10] w-full border-b-2 border-text object-cover object-top" %>
        <div class="flex grow flex-col p-5">
          <p class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-text-muted"><%= study.title %> · <%= c.vertical %></p>
          <h3 class="mt-2.5 text-[19px] font-bold leading-tight tracking-tight"><%= c.h %></h3>
          <% if c.story.happened.present? %><p class="mb-6 mt-3 text-[14.5px] leading-snug text-text-subtle"><%= c.story.happened %></p><% end %>
          <% if c.outcome.stat.present? %>
            <p class="mt-auto flex flex-wrap items-baseline gap-x-2 border-t-2 border-text pt-4"><span class="font-mono text-[17px] font-bold tabular text-primary"><%= c.outcome.stat %></span><span class="text-[13.5px] leading-snug text-text-subtle"><%= c.outcome.label %></span></p>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
  <div class="reveal mt-10"><%= button.("cases") %></div>
<% end %>

<% if lp.show_evidence && lead_f&.evidence&.any? %>
  <%= gl_section(tone: "subtle") do %>
    <div class="max-w-3xl">
      <%= gl_eyebrow("Inside one inherited account", "The receipts") %>
      <h2 class="reveal display display-lg">This is what the last agency's account <span class="mark">actually looked like.</span></h2>
      <p class="reveal mt-6 text-lg leading-snug text-text-subtle"><%= lead.title %> came to us from another agency. Everything below is from their own Google Ads account, and their client agreed to publish it. We show it because it is what an audit finds, and because none of it was visible in the reports they were being sent.</p>
    </div>
    <div class="mt-12 grid items-start gap-8 lg:grid-cols-2" data-stagger>
      <% lead_f.evidence.each do |e| %>
        <article class="reveal flex flex-col border-2 border-text bg-surface p-6 md:p-7">
          <h3 class="text-xl font-bold leading-tight tracking-tight"><%= e.heading %></h3>
          <% if e.body.present? %><p class="mt-3 text-[15px] leading-snug text-text-subtle"><%= e.body %></p><% end %>
          <% if e.table.head.any? %>
            <div class="mt-5 overflow-x-auto">
              <table class="w-full border-collapse text-left text-[13.5px]">
                <thead><tr class="border-b-2 border-text"><% e.table.head.each do |h| %><th scope="col" class="px-2 py-2 font-mono text-[10.5px] uppercase tracking-[0.1em] text-text-muted first:pl-0"><%= h %></th><% end %></tr></thead>
                <tbody>
                  <% e.table.rows.each do |row| %>
                    <tr class="border-b border-border last:border-b-0"><% row.cells.each_with_index do |cell, ci| %><td class="<%= class_names("px-2 py-2 align-top leading-snug first:pl-0", "font-medium": ci.zero?, "tabular text-text-subtle": ci.positive?) %>"><%= cell %></td><% end %></tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
          <% if e.quote.present? %><p class="mt-auto border-l-2 border-signal pl-4 pt-5 text-[16px] font-semibold leading-snug"><%= e.quote %></p><% end %>
        </article>
      <% end %>
    </div>
    <% if lead_f["method"].present? %><p class="reveal mt-8 max-w-4xl border-t-2 border-text pt-5 text-[13px] leading-relaxed text-text-muted"><span class="font-semibold text-text">How this was measured.</span> <%= lead_f["method"] %></p><% end %>
    <div class="reveal mt-8"><%= button.("evidence") %></div>
  <% end %>
<% end %>

<%= gl_section do %>
  <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div>
      <%= gl_eyebrow("The team", "Who you get") %>
      <h2 class="reveal display display-md"><%= ad.founders.heading %></h2>
      <p class="reveal mt-6 text-lg leading-snug text-text-subtle"><%= ad.founders.sub %></p>
      <div class="reveal mt-8"><%= button.("founders") %></div>
    </div>
    <div class="grid gap-6 sm:grid-cols-2" data-stagger>
      <% team.each do |person| %>
        <% p = website_fields(person) %>
        <figure class="reveal flex flex-col border-2 border-text bg-surface">
          <%= gl_image p.photo, alt: person.title, sizes: "(min-width: 640px) 22rem, 100vw", class: "block aspect-square w-full border-b-2 border-text object-cover" %>
          <figcaption class="p-5">
            <p class="text-xl font-bold tracking-tight"><%= person.title %></p>
            <p class="mt-0.5 font-mono text-[11px] uppercase tracking-[0.14em] text-primary"><%= p.role %></p>
            <p class="mt-3 text-[14.5px] leading-snug text-text-subtle"><%= p.bio %></p>
          </figcaption>
        </figure>
      <% end %>
    </div>
  </div>
<% end %>

<%= gl_section(tone: "subtle") do %>
  <%= render "website/shared/numbered_list", eyebrow: "What this fixes", eyebrow_n: "Sound familiar?", heading: "#{lp.pain_heading[0]}^#{lp.pain_heading[1]}^", quoted: true, items: lp.pains.map { |p| [p.t, p.d] } %>
<% end %>

<%= gl_section do %>
  <div class="max-w-3xl">
    <%= gl_eyebrow("How we run it", "The difference") %>
    <h2 class="reveal display display-lg">Ask any agency these eight questions. <span class="mark">Ours are in writing.</span></h2>
  </div>
  <div class="reveal mt-12 overflow-x-auto border-2 border-text">
    <table class="w-full min-w-[42rem] border-collapse bg-surface text-left">
      <thead>
        <tr class="border-b-2 border-text bg-bg-subtle">
          <th scope="col" class="px-5 py-3.5 font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted"><span class="sr-only">Question</span></th>
          <th scope="col" class="px-5 py-3.5 font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted">Most agencies</th>
          <th scope="col" class="px-5 py-3.5 font-mono text-[11px] uppercase tracking-[0.14em] text-primary">GoLumin</th>
        </tr>
      </thead>
      <tbody>
        <% ad.comparison.rows.each do |row| %>
          <tr class="border-b border-border last:border-b-0">
            <th scope="row" class="w-[11rem] px-5 py-4 align-top text-[14px] font-semibold leading-snug"><%= row.k %></th>
            <td class="px-5 py-4 align-top text-[14.5px] leading-snug text-text-muted"><%= row.a %></td>
            <td class="border-l-2 border-text px-5 py-4 align-top text-[14.5px] font-medium leading-snug"><%= row.b %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="reveal mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 border-2 border-text bg-surface px-5 py-4">
    <%= gl_image ad.credentials.badge, alt: "Google Partner", sizes: "5rem", class: "h-14 w-auto shrink-0" %>
    <p class="max-w-xl text-[14px] leading-snug text-text-subtle"><span class="font-semibold text-text"><%= ad.credentials.title %>.</span> Every claim in the right-hand column is behaviour the software enforces, not a promise. Ask us to show you any of them on the call.</p>
  </div>
<% end %>

<% faq = (lp.faqs.map { |f| [f.q, f.a] } + ad.faqs.map { |f| [f.q, f.a] }).map { |q, a| Struct.new(:question, :answer).new(q, a) } %>
<%= render "website/shared/faq", items: faq, heading: "Before you send it.", tone: "subtle" %>

<div class="brand-gradient-bg text-white">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-3 px-5 py-6 md:flex-row md:items-center md:justify-between md:px-8">
    <p class="text-[17px] font-semibold leading-snug md:text-xl"><%= ad.offer.headline %> <span class="font-normal text-white/80">A <%= ad.offer.value %> build, included with every account.</span></p>
    <a href="#lp-form" data-cta="<%= cta.("banner-close") %>" class="inline-flex h-12 shrink-0 items-center justify-center rounded-md bg-white px-6 text-[15px] font-semibold text-text transition-transform hover:scale-[1.02]"><%= lp.submit_label %></a>
  </div>
</div>

<%= render "website/shared/audit_section", eyebrow: "Free plan", heading: lp.closing.h, blurb: lp.closing.blurb, audit_type: lp.audit_type, lock_type: true, submit_label: lp.submit_label,
  note: ad.plan.refrain, prefix: "lp-#{entry.slug}-footer",
  bullets: ["The written plan is yours, hired or not", "Read-only access — nothing in your account changes", "A landing page built free if you do come on board"] %>
