<%# locals: (items:, columns: "3", figures: false, h2: false) -%>
<%# A row of step cards: [kicker, title, body]. figures: the kicker set large (a worked example's clock). %>
<ol class="steps<%= " is-two" if columns.to_s == "2" %><%= " is-four" if columns.to_s == "4" %>" data-stagger>
  <% items.each do |kicker, title, body| %>
    <li class="step reveal">
      <% if kicker.present? %>
        <% if figures %><p class="num"><%= kicker %></p><% else %><p class="step-when"><%= kicker %></p><% end %>
      <% end %>
      <% if title.present? %><%= content_tag(h2 ? :h2 : :h3, title, class: "h-4") %><% end %>
      <% if body.present? %><p><%= body %></p><% end %>
    </li>
  <% end %>
</ol>
