<%# locals: (label:, linked: true) -%>
<%# The band of client marks under the hero, as a marquee (nav.js doubles the track so the loop is seamless): every case study with a logo, each to its write-up (unlinked on the landing pages, which offer no exits), and every other client cleared for public mention as a wordmark, interleaved. %>
<% logos = gl_work.select { |study| website_fields(study).logo.present? } %>
<% names = gl_clients.map(&:title) - logos.map(&:title) %>
<% items = logos.zip(names).flatten.compact + (names.size > logos.size ? names[logos.size..] : []) %>
<% if items.any? %>
  <section class="logo-band">
    <% if label.present? %><div class="container"><span class="logo-band-label"><%= label %></span></div><% end %>
    <div class="marquee" aria-label="Clients">
      <div class="marquee-track" data-marquee>
        <% items.each do |item| %>
          <% if item.is_a?(String) %>
            <span class="marquee-item is-text"><%= item %></span>
          <% elsif linked %>
            <a class="marquee-item" href="<%= website_path(item) %>" data-cta="logo-<%= item.slug %>" aria-label="<%= item.title %>: read the case study"><%= gl_image(website_fields(item).logo, alt: item.title, sizes: "10rem", loading: :lazy) %></a>
          <% else %>
            <span class="marquee-item"><%= gl_image(website_fields(item).logo, alt: item.title, sizes: "10rem", loading: :lazy) %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
