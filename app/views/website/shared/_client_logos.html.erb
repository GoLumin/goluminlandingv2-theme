<%# locals: (label:, linked: true) -%>
<%# The band of client marks under the hero: every case study with a logo, each to its write-up (unlinked on the landing pages, which offer no exits). %>
<% logos = gl_work.select { |study| website_fields(study).logo.present? } %>
<% if logos.any? %>
  <section class="logo-band">
    <div class="container logo-band-inner">
      <% if label.present? %><span class="logo-band-label"><%= label %></span><% end %>
      <div class="logo-list">
        <% logos.each do |study| %>
          <% img = gl_image(website_fields(study).logo, alt: study.title, sizes: "9rem", loading: :lazy) %>
          <% if linked %>
            <a href="<%= website_path(study) %>" data-cta="logo-<%= study.slug %>" aria-label="<%= study.title %>: read the case study"><%= img %></a>
          <% else %>
            <%= img %>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
