<%# locals: () -%>
<%# A landing page's slim footer: the copyright, the phone, the email and the privacy policy. %>
<footer class="footer footer-lp">
  <div class="container footer-bottom">
    <span>&copy; <%= gl_year %> <%= gl_name %> · Websites, search and advertising</span>
    <span class="footer-links"><a href="<%= gl_tel %>"><%= gl_phone %></a><a href="mailto:<%= gl_email %>"><%= gl_email %></a><a href="/privacy">Privacy</a></span>
  </div>
</footer>
