<%# locals: (study:, eager: false) -%>
<%# A case study as a card: its homepage, the headline figure the client agreed to share (else a build figure), what it measures, the story's headline, and the client. %>
<% c = website_fields(study) %>
<% figure = gl_case_figure(c) %>
<a class="case-card reveal" href="<%= website_path(study) %>" data-cta="work-<%= study.slug %>">
  <div class="case-shot"><%= gl_image c.screenshot, alt: "", sizes: "(min-width: 72rem) 34rem, (min-width: 720px) 50vw, 100vw", loading: eager ? :eager : :lazy %></div>
  <div class="case-body">
    <% if figure %>
      <span class="num"><%= figure[0] %></span>
      <h3 class="h-4"><%= figure[1].to_s.upcase_first %></h3>
    <% else %>
      <h3 class="h-4"><%= gl_plain(c.h) %></h3>
    <% end %>
    <p><%= figure ? gl_plain(c.h) : c.lede %></p>
    <p class="case-meta"><%= [study.title, c.vertical, figure&.at(2)].compact_blank.join(" · ") %></p>
  </div>
</a>
