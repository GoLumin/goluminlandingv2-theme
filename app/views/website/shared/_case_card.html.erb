<%# locals: (study:, eager: false) -%>
<%# A case study as a card (ui/CaseCard.astro): its homepage in a browser frame, the headline, the outcome where the client shared one, the tags. %>
<% c = website_fields(study) %>
<a href="<%= website_path(study) %>" class="reveal lift group block rounded-lg border border-border bg-surface">
  <div class="flex items-center gap-1.5 border-b border-border-light bg-bg-subtle px-3 py-2">
    <span class="h-2.5 w-2.5 rounded-full bg-border"></span><span class="h-2.5 w-2.5 rounded-full bg-border"></span><span class="h-2.5 w-2.5 rounded-full bg-border"></span>
    <span class="ml-2 truncate font-mono text-[11px] text-text-muted"><%= c.host %></span>
  </div>
  <%= gl_image c.screenshot, sizes: "(min-width: 72rem) 34rem, (min-width: 768px) 50vw, 100vw", loading: eager ? :eager : :lazy, class: "block aspect-[16/10] w-full object-cover object-top" %>
  <div class="border-t border-border-light p-5">
    <div class="flex items-center justify-between gap-4">
      <h3 class="text-xl font-bold tracking-tight"><%= study.title %></h3>
      <span class="shrink-0 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
    </div>
    <p class="mt-1 font-mono text-[11px] uppercase tracking-wider text-text-muted"><%= c.vertical %> · <%= c.place %></p>
    <p class="mt-3 text-[15px] font-medium leading-snug"><%= c.h %></p>
    <% if c.outcome.stat.present? %>
      <p class="mt-3 flex flex-wrap items-baseline gap-x-2 gap-y-0.5 border-t border-border pt-3">
        <span class="font-mono text-[15px] font-semibold text-text"><%= c.outcome.stat %></span>
        <span class="text-[13px] leading-snug text-text-subtle"><%= c.outcome.label %></span>
      </p>
    <% end %>
    <div class="mt-4 flex flex-wrap gap-1.5 font-mono text-[10.5px] uppercase tracking-wider">
      <% c.tags.each do |t| %><span class="border border-border px-1.5 py-0.5 text-text-subtle"><%= t %></span><% end %>
    </div>
  </div>
</a>
