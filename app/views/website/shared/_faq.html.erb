<%# locals: (items:, heading:, eyebrow: "Questions", tone: "bg") -%>
<%# Questions that spring open in place (Faq.astro, motion.js), with their FAQPage structured data. items: {question, answer}. %>
<%= gl_section(tone:, id: "faq") do %>
  <div class="grid gap-10 md:grid-cols-[1fr_1.6fr]">
    <div>
      <%= gl_eyebrow("First call", eyebrow) %>
      <h2 class="reveal display display-lg"><%= gl_heading(heading) %></h2>
    </div>
    <div class="rule-t">
      <% items.each do |item| %>
        <details class="faq group border-b border-border py-5">
          <summary class="flex items-center justify-between gap-4 text-lg font-semibold tracking-tight">
            <%= item.question %>
            <span class="chev shrink-0 text-text-muted" aria-hidden="true">⌄</span>
          </summary>
          <div class="faq-body"><div><p class="mt-3 pr-8 text-[15px] leading-snug text-text-subtle"><%= item.answer %></p></div></div>
        </details>
      <% end %>
    </div>
  </div>
  <%= gl_faq_schema(items) %>
<% end %>
