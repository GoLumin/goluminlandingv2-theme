<%# locals: (items:, heading:, eyebrow: "Questions", tone: "bg", body: nil) -%>
<%# Questions that open in place (motion.js), beside the heading, with their FAQPage structured data. items: {question, answer}. %>
<%= gl_section(tone:, id: "faq") do %>
  <div class="faq-grid">
    <div class="reveal">
      <%= gl_eyebrow(eyebrow) %>
      <h2 class="h-2"><%= gl_heading(heading) %></h2>
      <% if body.present? %><p class="lede"><%= body %></p><% end %>
    </div>
    <div class="faq-list reveal" style="--i:1">
      <% items.each do |item| %>
        <details class="faq">
          <summary><%= item.question %></summary>
          <div class="faq-body"><div><p><%= item.answer %></p></div></div>
        </details>
      <% end %>
    </div>
  </div>
  <%= gl_faq_schema(items) %>
<% end %>
