<%# locals: (quote:, klass: "") -%>
<%# The compact quote beside a form. %>
<% q = website_fields(quote) %>
<figure class="quote-stat <%= klass %>">
  <blockquote><p class="quote-text" style="font-size:19px"><%= q.quote %></p></blockquote>
  <figcaption class="quote-by"><strong><%= quote.title %></strong> · <%= [q.role, q.company].compact_blank.join(", ") %></figcaption>
  <% if q.result_figure.present? %><p style="margin-top:14px"><span class="num" style="font-size:32px;color:var(--violet)"><%= q.result_figure %></span> <span class="small"><%= q.result_label %></span></p><% end %>
</figure>
