<%# locals: (prefix: "hero", source: nil, cta: nil, compact: false, audit_type: nil, lock_type: false, kicker: "Request, diagnostic", heading: "Book a diagnostic", blurb: nil, submit_label: "Request my audit", note: nil, phone_href: nil, phone_label: nil) -%>
<%#
  THE AUDIT FORM. Wiring frozen, see FORM-CONTRACT.md in
  ~/Downloads/lumin-method-reference. Not altered here:
    action="/api/forms/audit/submissions", method="post", novalidate
    data-audit-form, data-form-slug="audit"
    the 21 names: audit_type name email company website_url monthly_ad_spend
      message _hp utm_source utm_medium utm_campaign utm_term utm_content
      gclid fbclid msclkid v landing_path referrer source form_path
    every <option value>, en dashes included
    required on audit_type, name, email, company, monthly_ad_spend
    the _hp honeypot, present and visually hidden
    `source` carries the placement
    the data-* hooks forms.js binds to
  The look is the Method design's own form (pages/work-with-us.html:
  .wwu-form-wrap, .form-cap, .field, .row, .wwu-submit). That page's form is
  a dead mock with different field names; only its styling is borrowed. It
  offers the audit type as radio chips, but the contract specifies a select,
  so this stays a select.
%>
<% src = source.presence || "golumin-landing-#{prefix}" %>
<% types = ["Full system (web + search + ads)", "Website", "Local + AI search", "Ad account"] %>
<% chosen = types.include?(audit_type) ? audit_type : types.first %>
<div class="wwu-form-wrap">
  <div class="form-cap"><span><%= kicker.to_s.upcase %></span><span class="signal">OPEN</span></div>
  <form id="<%= prefix %>-form" data-audit-form data-form-slug="audit" method="post"
        action="/api/forms/audit/submissions" class="wwu-form" novalidate>
    <% if heading.present? || blurb.present? %>
      <div class="form-intro">
        <% if heading.present? %><h3 class="headline form-title"><%= heading %></h3><% end %>
        <% if blurb.present? %><p class="form-sub"><%= blurb %></p><% end %>
      </div>
    <% end %>

    <% if lock_type %>
      <input type="hidden" name="audit_type" value="<%= chosen %>" data-audit-type>
    <% else %>
      <div class="field">
        <label for="<%= prefix %>-type">What should we look at?</label>
        <select id="<%= prefix %>-type" name="audit_type" required data-audit-type>
          <% types.each do |t| %><option value="<%= t %>"<%= " selected" if t == chosen %>><%= t %></option><% end %>
        </select>
      </div>
    <% end %>

    <div class="row">
      <div class="field">
        <label for="<%= prefix %>-name">Name</label>
        <input id="<%= prefix %>-name" name="name" type="text" placeholder="Your name" autocomplete="name" required>
      </div>
      <div class="field">
        <label for="<%= prefix %>-email">Work email</label>
        <input id="<%= prefix %>-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" inputmode="email" required data-email>
      </div>
    </div>

    <div class="row">
      <div class="field">
        <label for="<%= prefix %>-company">Business</label>
        <input id="<%= prefix %>-company" name="company" type="text" placeholder="Company" autocomplete="organization" required>
      </div>
      <div class="field">
        <label for="<%= prefix %>-site">Website</label>
        <input id="<%= prefix %>-site" name="website_url" type="text" placeholder="yourbusiness.com" inputmode="url" autocomplete="url">
      </div>
    </div>

    <div class="field" data-spend-field>
      <label for="<%= prefix %>-spend">Monthly ad spend</label>
      <select id="<%= prefix %>-spend" name="monthly_ad_spend" required data-spend>
        <option value="">Choose one</option>
        <option value="Not running ads yet">Not running ads yet</option>
        <option value="Under $2,000">Under $2,000</option>
        <option value="$2,000 – $10,000">$2,000 – $10,000</option>
        <option value="$10,000 – $50,000">$10,000 – $50,000</option>
        <option value="$50,000+">$50,000+</option>
      </select>
    </div>

    <div class="field">
      <label for="<%= prefix %>-msg">What are you running now?</label>
      <textarea id="<%= prefix %>-msg" name="message" rows="3" placeholder="Channels, spend, what's working, what isn't."></textarea>
    </div>

    <div class="visually-hidden" aria-hidden="true">
      <label>Leave this empty <input type="text" name="_hp" tabindex="-1" autocomplete="off"></label>
    </div>
    <input type="hidden" name="utm_source"><input type="hidden" name="utm_medium">
    <input type="hidden" name="utm_campaign"><input type="hidden" name="utm_term">
    <input type="hidden" name="utm_content"><input type="hidden" name="gclid">
    <input type="hidden" name="fbclid"><input type="hidden" name="msclkid">
    <input type="hidden" name="v"><input type="hidden" name="landing_path">
    <input type="hidden" name="referrer">
    <input type="hidden" name="source" value="<%= src %>">
    <input type="hidden" name="form_path">

    <p class="form-error" data-error role="alert" hidden></p>
    <button type="submit" data-submit data-cta="<%= cta.presence || "#{prefix}-form" %>" class="btn btn-primary wwu-submit"><%= submit_label %> <span class="arrow">&rarr;</span></button>
    <p class="form-note"><%= note.presence || "We reply within one business day. No sales sequence, no drip campaign." %> <a href="<%= phone_href.presence || gl_tel %>" class="ulink"><%= phone_label.presence || gl_phone %></a></p>
  </form>
</div>
