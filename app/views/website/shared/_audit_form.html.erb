<%# locals: (prefix: "hero", source: nil, heading: "Book a diagnostic", blurb: "A 20-minute look at what you're running. No pitch deck, no commitment.", submit_label: "Request my audit", tone: "light") -%>
<%#
  THE AUDIT FORM. The wiring is frozen: see FORM-CONTRACT.md in
  ~/Downloads/lumin-method-reference. Lifted from production golumin.io and
  not altered here. Frozen, do not touch:
    action="/api/forms/audit/submissions", method="post"
    data-audit-form, data-form-slug="audit"
    every name= : audit_type name email company website_url monthly_ad_spend
                  message _hp utm_source utm_medium utm_campaign utm_term
                  utm_content gclid fbclid msclkid v landing_path referrer
                  source form_path
    every <option value> on audit_type and monthly_ad_spend, en dashes and all
    required on audit_type, name, email, company, monthly_ad_spend
    the honeypot _hp, present and visually hidden
    `source` carries the placement: golumin-landing-hero / -footer
  Only the classes, labels and layout below are this design's. The button's
  visible text is a label, not wiring, so it drops the word "free".
%>
<% src = source.presence || "golumin-landing-#{prefix}" %>
<form id="<%= prefix %>-form" data-audit-form data-form-slug="audit" method="post"
      action="/api/forms/audit/submissions" class="form-card" novalidate>
  <div class="form-head">
    <p class="eyebrow">Start here</p>
    <h3 class="form-title"><%= heading %></h3>
    <p class="form-sub"><%= blurb %></p>
  </div>

  <label class="field">
    <span class="field-label">What should we look at? <span class="req">*</span></span>
    <select name="audit_type" required data-audit-type>
      <option value="Full system (web + search + ads)">Full system (web + search + ads)</option>
      <option value="Website">Website</option>
      <option value="Local + AI search">Local + AI search</option>
      <option value="Ad account">Ad account</option>
    </select>
  </label>

  <div class="field-row">
    <label class="field">
      <span class="field-label">Name <span class="req">*</span></span>
      <input type="text" name="name" autocomplete="name" required>
    </label>
    <label class="field">
      <span class="field-label">Work email <span class="req">*</span></span>
      <input type="email" name="email" autocomplete="email" inputmode="email" required data-email>
    </label>
  </div>

  <div class="field-row">
    <label class="field">
      <span class="field-label">Business <span class="req">*</span></span>
      <input type="text" name="company" autocomplete="organization" required>
    </label>
    <label class="field">
      <span class="field-label">Website</span>
      <input type="text" name="website_url" inputmode="url" autocomplete="url" placeholder="yourbusiness.com">
    </label>
  </div>

  <label class="field" data-spend-field>
    <span class="field-label">Monthly ad spend <span class="req">*</span></span>
    <select name="monthly_ad_spend" required data-spend>
      <option value="">Choose one</option>
      <option value="Not running ads yet">Not running ads yet</option>
      <option value="Under $2,000">Under $2,000</option>
      <option value="$2,000 – $10,000">$2,000 – $10,000</option>
      <option value="$10,000 – $50,000">$10,000 – $50,000</option>
      <option value="$50,000+">$50,000+</option>
    </select>
  </label>

  <label class="field">
    <span class="field-label">What's the biggest headache right now?</span>
    <textarea name="message" rows="3" placeholder="e.g. We spend $8k a month on Google and can't tell what it's doing."></textarea>
  </label>

  <div class="visually-hidden" aria-hidden="true">
    <label>Leave this empty <input type="text" name="_hp" tabindex="-1" autocomplete="off"></label>
  </div>
  <input type="hidden" name="utm_source"><input type="hidden" name="utm_medium">
  <input type="hidden" name="utm_campaign"><input type="hidden" name="utm_term">
  <input type="hidden" name="utm_content"><input type="hidden" name="gclid">
  <input type="hidden" name="fbclid"><input type="hidden" name="msclkid">
  <input type="hidden" name="v"><input type="hidden" name="landing_path">
  <input type="hidden" name="referrer">
  <input type="hidden" name="source" value="<%= src %>">
  <input type="hidden" name="form_path">

  <p class="form-error" data-error role="alert" hidden></p>
  <button type="submit" data-submit data-cta="<%= prefix %>-form" class="btn btn-primary"><%= submit_label %> <span class="arrow">&rarr;</span></button>
  <p class="form-note">Read-only access. Jordan or Ted reads it. Rather talk? <a href="<%= gl_tel %>" class="ulink"><%= gl_phone %></a></p>
</form>
