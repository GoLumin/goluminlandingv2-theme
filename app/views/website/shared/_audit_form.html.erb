<%# locals: (prefix:, audit_type: nil, cta: "form", compact: false, lock_type: false, submit_label: nil, kicker: nil, heading: nil, blurb: nil, note: nil, phone_href: nil, phone_label: nil) -%>
<%# The audit form (the form card of the redesign), drawn by hand from Forms › audit and posted to the Forms plugin (forms.js), which sends the visitor on to /thank-you. The audit type routes the request: asked first, or fixed by the landing page (lock_type). Monthly ad spend is asked only when the audit involves ads. Every id carries the prefix, since a page can hold two; the page's first form is #plan-form, where the phone's bar and every "Request an audit" button land. %>
<% form = gl_form(:audit) %>
<% if form %>
  <% types = gl_choices(gl_field(form, :audit_type)).pluck("value") %>
  <% audit_type = audit_type.presence_in(types) || types.first %>
  <% spend = ["Full system (web + search + ads)", "Ad account"].include?(audit_type) %>
  <% id = ->(name) { "#{prefix}-#{name}" } %>
  <% key = gl_turnstile_key %>
  <% first = !content_for?(:gl_plan_form) %>
  <% content_for(:gl_plan_form, "1") if first %>
  <% readers = gl_team.first(2) %>
  <form id="<%= first ? "plan-form" : "#{prefix}-form" %>" data-audit-form data-form-slug="audit" method="post" action="<%= api_form_submissions_path(form_slug: form.slug) %>" class="form-card" novalidate>
    <div class="form-head">
      <% if kicker.present? %><p class="eyebrow" style="margin-bottom:6px"><%= kicker %></p><% end %>
      <h3 class="form-title"><%= heading.presence || "Request a marketing audit" %></h3>
      <p class="form-sub"><%= blurb.presence || "Tell us where the business is now. For businesses already investing in marketing, or ready to. A partner reads it personally." %></p>
    </div>
    <% if lock_type %>
      <input type="hidden" name="audit_type" value="<%= audit_type %>" data-audit-type>
    <% else %>
      <%= gl_control(form, :audit_type, id: id.("audit"), label: "What should we look at?", select: {selected: audit_type}, data: {audit_type: true}) %>
    <% end %>
    <div class="field-row">
      <%= gl_control(form, :name, id: id.("name"), label: "Name", autocomplete: "name") %>
      <%= gl_control(form, :email, id: id.("email"), label: "Work email", autocomplete: "email", inputmode: "email", data: {email: true}) %>
    </div>
    <div class="field-row">
      <%= gl_control(form, :company, id: id.("company"), label: "Business", autocomplete: "organization") %>
      <%= gl_control(form, :website_url, id: id.("website"), label: "Website", inputmode: "url", autocomplete: "url", placeholder: "yourbusiness.com") %>
    </div>
    <%= tag.div(gl_control(form, :monthly_ad_spend, id: id.("spend"), label: "Monthly ad spend", required: spend, select: {prompt: "Choose one"}, data: {spend: true}), hidden: !spend, data: {spend_field: true}) %>
    <% unless compact %>
      <%= gl_control(form, :message, id: id.("message"), label: "What's the biggest headache right now?", hint: "(optional)", rows: 3) %>
    <% end %>
    <div style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true">
      <label>Leave this empty <input type="text" name="<%= Form::HONEYPOT_FIELD %>" tabindex="-1" autocomplete="off"></label>
    </div>
    <%= gl_attribution(form, source: "golumin-#{prefix}") %>
    <% if key %><div data-turnstile data-sitekey="<%= key %>"></div><% end %>
    <p data-error class="form-error" role="alert" hidden></p>
    <button type="submit" data-submit data-cta="<%= cta %>" class="btn btn-primary btn-block"><%= submit_label.presence || "Request my audit" %></button>
    <div class="form-readers">
      <% if readers.any? %>
        <span class="form-avatars">
          <% readers.each do |person| %><%= gl_image website_fields(person).photo, alt: "", sizes: "2rem", loading: :lazy, width: 32, height: 32 %><% end %>
        </span>
      <% end %>
      <span><%= note.presence || "#{readers.map { it.title.split.first }.to_sentence(two_words_connector: " or ")} reads it and replies from a real inbox. No sequence, no sales team." %>
        Rather talk? <a href="<%= phone_href.presence || gl_tel %>" data-cta="form-phone"><%= phone_label.presence || gl_phone %></a>.</span>
    </div>
    <p class="form-fine"><a href="/privacy">Privacy</a></p>
  </form>
<% end %>
