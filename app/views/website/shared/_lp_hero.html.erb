<%# locals: (entry:, lp:, extra: nil, form: nil) -%>
<%# A landing page's first screen: the eyebrow, the two-part headline (its variants swapped in by ?v=), the standfirst, the jump to the form on a phone, the reassurances, then the form beside it. %>
<% named = gl_clients.map(&:title) %>
<section class="relative overflow-hidden">
  <div class="grid-paper pointer-events-none absolute inset-0 -z-10 opacity-70"></div>
  <div class="mx-auto grid max-w-6xl items-start gap-10 px-5 pb-14 pt-10 md:px-8 md:pb-20 md:pt-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14" data-stagger>
    <div>
      <p class="reveal mb-6 flex items-center gap-3 font-mono text-[12px] uppercase tracking-[0.14em] sm:tracking-[0.18em]"><span class="pulse-dot relative inline-block h-2 w-2 shrink-0 rounded-full bg-signal"></span><span class="font-semibold"><%= lp.eyebrow %></span></p>
      <h1 class="reveal display display-hero"><span data-lp-h1><%= lp.h[0] %></span><span class="brand-gradient-text" data-lp-h2><%= lp.h[1] %></span></h1>
      <p class="reveal mt-6 max-w-xl text-lg leading-snug text-text-subtle md:text-[22px]" data-lp-sub><%= lp.sub %></p>
      <a href="#lp-form" data-cta="lp-<%= entry.slug %>-hero-mobile" class="reveal mt-6 flex h-14 w-full items-center justify-center rounded-md bg-text text-base font-semibold text-bg lg:hidden"><%= lp.submit_label %></a>
      <ul class="reveal mt-8 space-y-3 text-[16px]">
        <% lp.checks.each do |check| %><li class="flex items-start gap-3"><%= gl_check %><span class="font-medium"><%= check %></span></li><% end %>
      </ul>
      <%= extra %>
      <% if named.any? %>
        <p class="reveal mt-8 text-[13.5px] leading-snug text-text-muted">
          <span class="font-mono text-[11px] uppercase tracking-[0.14em]">Running now for</span>
          <% named.first(3).each_with_index do |name, i| %><% if i.positive? %><span aria-hidden="true"> · </span><% end %><span class="font-semibold text-text"><%= name %></span><% end %>
          <% if named.size > 3 %><span> and others</span><% end %>
        </p>
      <% end %>
    </div>
    <div id="lp-form" class="reveal scroll-mt-20" style="--i:1"><%= form %></div>
  </div>
</section>
