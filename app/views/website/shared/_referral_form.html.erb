<%# locals: () -%>
<%# The referral form, from Forms › referral. Its first field routes it: someone who wants the programme first isn't asked for a contact they don't have (forms.js hides [data-referral-field]). %>
<% form = gl_form(:referral) %>
<% if form %>
  <% section = ->(label, extra = nil) { tag.p(label, class: "eyebrow", style: "margin-top:10px", data: extra) } %>
  <form id="referral-form" data-audit-form data-form-slug="referral" method="post" action="<%= api_form_submissions_path(form_slug: form.slug) %>" class="form-card" novalidate>
    <div class="form-head"><h3 class="form-title">Register a referral</h3><p class="form-sub">Registered the moment this lands. We reply within one business day.</p></div>
    <%= gl_control(form, :referral_type, id: "referral-type", select: {selected: "Referral"}, data: {referral_type: true}) %>
    <%= section.("You") %>
    <div class="field-row">
      <%= gl_control(form, :name, id: "referral-name", autocomplete: "name") %>
      <%= gl_control(form, :email, id: "referral-email", autocomplete: "email", inputmode: "email", data: {email: true}) %>
    </div>
    <div class="field-row">
      <%= gl_control(form, :company, id: "referral-company", hint: "(optional)", autocomplete: "organization") %>
      <%= gl_control(form, :relationship, id: "referral-relationship", select: {prompt: "Choose one"}) %>
    </div>
    <%= section.("Who you're introducing", {referral_field: true}) %>
    <div class="field-row" data-referral-field>
      <%= gl_control(form, :referral_company, id: "referral-refco", required: true) %>
      <%= gl_control(form, :referral_website, id: "referral-refsite", hint: "(optional)", inputmode: "url") %>
    </div>
    <div data-referral-field><%= gl_control(form, :referral_contact, id: "referral-refcontact", hint: "(name, and an email or phone)", required: true) %></div>
    <div data-referral-field><%= gl_control(form, :referral_services, id: "referral-refneeds", required: true, select: {prompt: "Choose one"}) %></div>
    <%= section.("Getting paid") %>
    <%= gl_control(form, :payout_pref, id: "referral-payout", select: {prompt: "Choose one"}) %>
    <%= gl_control(form, :message, id: "referral-message", hint: "(optional)", rows: 3) %>
    <%= render "website/shared/form_tail", form:, source: "golumin-referrals", cta: "referral", label: form.submit_label %>
    <p class="form-fine">Rather just call it in? <a href="<%= gl_tel %>" data-cta="referral-phone"><%= gl_phone %></a> · <a href="/privacy">Privacy</a></p>
  </form>
<% end %>
