<%# locals: (service:) -%>
<%# One service as a card: the homepage of its first case study, its name, its promise, three capabilities, and its proof. The whole card goes to the service's page. %>
<% s = website_fields(service) %>
<% shot = gl_cases(s.cases).first %>
<a class="service-card reveal" href="<%= website_path(service) %>" data-cta="service-card-<%= service.slug %>">
  <% if shot %>
    <div class="service-shot"><%= gl_image website_fields(shot).screenshot, alt: "", sizes: "(min-width: 72rem) 24rem, (min-width: 720px) 50vw, 100vw", loading: :lazy %></div>
  <% end %>
  <div class="service-body">
    <h3 class="h-3"><%= s.nav.presence || service.title %></h3>
    <% if s.promise.present? %><p class="service-promise"><%= s.promise %></p><% end %>
    <ul class="service-list">
      <% s.capabilities.first(3).each do |c| %><li><%= c %></li><% end %>
    </ul>
    <% if s.proof.fact.present? %>
      <div class="service-fact"><span><strong><%= s.proof.fact %></strong><% if s.proof.source.present? %> <%= s.proof.source %><% end %></span></div>
    <% end %>
  </div>
</a>
