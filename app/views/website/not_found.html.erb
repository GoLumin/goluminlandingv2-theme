<%# locals: () -%>
<%# Page not found: the CMS's "not-found" page, its blocks, never indexed. Without one, a plain line back home. %>
<% page = Page.live.find_by(path: "not-found") %>
<% if page %>
  <% content_for :head, gl_seo_tags(page, noindex: true) %>
  <%= website_blocks page %>
<% else %>
  <% content_for :head, website_seo_tags(title: "Page not found | #{gl_name}", noindex: true) %>
  <section class="mx-auto max-w-6xl px-5 py-24 md:px-8">
    <h1 class="display display-xl">That page <span class="brand-gradient-text">isn't here.</span></h1>
    <p class="mt-8"><%= gl_button "Back to the homepage", "/", size: :lg %></p>
  </section>
<% end %>
