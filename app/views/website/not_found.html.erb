<%# locals: () -%>
<%# Page not found: the CMS's "not-found" page, its blocks, never indexed. Without one, a plain line back home. %>
<% page = Page.live.find_by(path: "not-found") %>
<% if page %>
  <% content_for :head, gl_seo_tags(page, noindex: true) %>
  <%= website_blocks page %>
<% else %>
  <% content_for :head, website_seo_tags(title: "Page not found | #{gl_name}", noindex: true) %>
  <section class="page-hero"><div class="hero-light" aria-hidden="true"></div><%= render "website/shared/hero_photo" %><div class="container page-hero-inner">
    <h1 class="h-hero">That page <span class="em">isn't here.</span></h1>
    <div class="hero-links"><%= gl_button "Back to the homepage", "/" %></div>
  </div></section>
<% end %>
