<%# locals: (entry:) -%>
<%# A case study: the headline, the live homepage, the story beside the outcome the client agreed to share, their figures, the build evidence, what the account showed, their quote, what we built line by line, more work and the plan form. %>
<% c = website_fields(entry) %>
<% proven = gl_services.select { |sv| Array(website_fields(sv).cases).include?(entry.slug) } %>
<% i = gl_work.index(entry) || 0 %>
<% more = [1, 2].map { |k| gl_work[(i + k) % gl_work.size] }.uniq - [entry] %>
<% quote = gl_testimonial(entry.slug) %>
<% figure = gl_case_figure(c) %>
<% content_for :head, gl_seo_tags(entry, description: c.lede, image: c.screenshot) %>
<% content_for :sticky_cta, "Get my free plan" %>
<section class="page-hero is-short">
  <div class="hero-light" aria-hidden="true"></div>
  <%= render "website/shared/hero_photo" %>
  <div class="container">
    <div class="page-hero-inner">
      <p class="breadcrumb"><a href="/work">Results</a><span aria-hidden="true">/</span><span><%= [entry.title, c.vertical, c.place].compact_blank.join(" · ") %></span></p>
      <h1 class="h-hero"><%= gl_heading(c.h) %></h1>
      <p class="lede"><%= c.lede %></p>
      <div class="hero-links">
        <% if gl_href(c.url) %><%= gl_button "Visit #{c.host} ↗", gl_href(c.url), variant: :outline, cta: "work-visit-#{entry.slug}", rel: "noopener", target: "_blank" %><% end %>
        <% if c.platform.present? %><span class="small"><%= c.platform %></span><% end %>
      </div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="reveal"><%= render "website/shared/screen", image: c.screenshot, browser: true, url: c.host, eager: true, alt: "#{entry.title} homepage" %></div>
  </div>
</section>

<% if c.story.problem.present? %>
  <%= gl_section(rule: true) do %>
    <div class="two-col">
      <div class="reveal">
        <%= gl_eyebrow("The story") %>
        <div class="case-steps" style="margin-top:0;gap:28px">
          <% [["The problem", c.story.problem], ["What we did", c.story.did], ["What happened", c.story.happened]].each do |term, text| %>
            <% next if text.blank? %>
            <div class="case-step"><h2 class="eyebrow"><%= term %></h2><p class="lede"><%= text %></p></div>
          <% end %>
        </div>
      </div>
      <% if figure %>
        <div class="reveal" style="--i:1">
          <div class="quote-stat sticky-side">
            <p class="eyebrow">Outcome</p>
            <span class="num bump-target"><%= figure[0] %></span>
            <p><%= figure[1].to_s.upcase_first %></p>
            <% if figure[2].present? %><p class="small"><%= figure[2] %></p><% end %>
            <p class="small" style="margin-top:16px">Shared with the client's agreement.</p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if c.stat_band.any? %>
  <%= gl_section(tone: "subtle", tight: true, rule: true) do %>
    <div class="stat-row<%= " is-four" if c.stat_band.size >= 4 %><%= " is-two" if c.stat_band.size == 2 %>" data-stagger>
      <% c.stat_band.each do |s| %>
        <div class="stat reveal"><span class="num bump-target"><%= s.n %></span><p><strong><%= s.l %></strong></p><% if s.sub.present? %><p class="small"><%= s.sub %></p><% end %></div>
      <% end %>
    </div>
    <p class="note reveal">The client's account data, shared with their agreement. Baseline, timeframe and method are stated below.</p>
  <% end %>
<% end %>

<% if c.figures.any? %>
  <%= gl_section(tight: true, rule: true) do %>
    <%= gl_eyebrow("The build", klass: "reveal") %>
    <div class="stat-row<%= " is-four" if c.figures.size >= 4 %>" data-stagger>
      <% c.figures.each do |f| %><div class="stat reveal"><span class="num bump-target"><%= f.n %></span><p><%= f.l %></p></div><% end %>
    </div>
    <p class="note reveal">Counted from <%= c.host %> and its sitemap at capture. Build evidence, not a performance claim.</p>
  <% end %>
<% end %>

<% if c.evidence.any? %>
  <%= gl_section(rule: true) do %>
    <div class="section-head reveal">
      <%= gl_eyebrow("What the account showed") %>
      <h2 class="h-2">Every figure below is from <span class="em">the client's own account.</span></h2>
    </div>
    <div class="stack" data-stagger>
      <% c.evidence.each do |e| %>
        <article class="reveal" style="padding-top:28px;border-top:1px solid var(--line)">
          <h3 class="h-3"><%= e.heading %></h3>
          <% if e.body.present? %><p class="lede" style="margin-top:12px"><%= e.body %></p><% end %>
          <% if e.table.head.any? %>
            <div class="table-wrap" style="margin-top:20px">
              <table class="data-table">
                <thead><tr><% e.table.head.each do |h| %><th scope="col"><%= h %></th><% end %></tr></thead>
                <tbody><% e.table.rows.each do |row| %><tr><% row.cells.each do |cell| %><td><%= cell %></td><% end %></tr><% end %></tbody>
              </table>
            </div>
          <% end %>
          <% if e.quote.present? %><p class="quote-text" style="margin-top:20px;font-size:22px"><%= e.quote %></p><% end %>
        </article>
      <% end %>
    </div>
    <% if c["method"].present? %><p class="note"><strong>Methodology.</strong> <%= c["method"] %></p><% end %>
  <% end %>
<% end %>

<% if quote %><%= render "website/shared/testimonial", quote:, link: false %><% end %>

<% if c.built.any? %>
  <%= gl_section(rule: true) do %>
    <div class="two-col">
      <div class="sticky-side reveal">
        <%= gl_eyebrow([c.platform, "What we built"].compact_blank.join(" · ")) %>
        <h2 class="h-2">The work, <span class="em">line by line.</span></h2>
        <% if c.tags.any? %><div class="chips" style="margin-top:20px"><% c.tags.each do |t| %><span class="chip"><%= t %></span><% end %></div><% end %>
        <div style="margin-top:28px">
          <p class="eyebrow"><%= proven.any? ? "Services behind this" : "What we do" %></p>
          <ul class="dash-list">
            <% if proven.any? %>
              <% proven.each do |sv| %><li><%= gl_dot %><a href="<%= website_path(sv) %>"><%= sv.title %></a></li><% end %>
            <% else %>
              <li><%= gl_dot %><a href="/services">Websites, local and AI search, advertising</a></li>
            <% end %>
          </ul>
        </div>
      </div>
      <ol class="ruled reveal" style="--i:1">
        <% c.built.each_with_index do |line, i| %>
          <li class="ruled-row"><span class="ruled-n"><%= gl_n(i) %></span><span><%= line %></span></li>
        <% end %>
      </ol>
    </div>
  <% end %>
<% end %>

<% if more.any? %>
  <%= gl_section(tone: "subtle", rule: true) do %>
    <div class="section-head-row reveal">
      <div class="section-head"><h2 class="h-2">More of the work.</h2></div>
      <a href="/work" class="btn-link">All case studies <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="case-grid" data-stagger><%= render partial: "website/shared/case_card", collection: more, as: :study %></div>
  <% end %>
<% end %>

<%= render "website/shared/audit_section", heading: "Pick the plan you actually need.", blurb: "Website, local and AI search, ad account, or all three. Read-only access, real findings on your own accounts, and a person who walks you through them. You keep the plan either way.",
  bullets: ["Read-only access. Nothing changes.", "No obligation, no slide deck.", "A person walks you through it."], tone: "bg" %>
<%= tag.div(hidden: true, data: {gl_event: {event: "view_case_study", case_slug: entry.slug, case_name: entry.title, case_vertical: c.vertical}.to_json}) %>
