<%# locals: (entry:) -%>
<%# A service's page: its headline and the plan it comes with, the problems it fixes, how the work runs, the software behind it, where it's running, the next service, its questions, and the plan form. %>
<% s = website_fields(entry) %>
<% next_service = gl_service(s.handoff.to) %>
<% others = gl_services.reject { |o| o == entry } %>
<% content_for :head, gl_seo_tags(entry, description: s.lede) %>
<% content_for :sticky_cta, "Request an audit" %>
<section class="page-hero is-night">
  <%= render "website/shared/scene" %>
  <div class="container">
    <div class="page-hero-inner">
      <%= render "website/shared/badge" %>
      <p class="breadcrumb"><a href="/services">Services</a><span aria-hidden="true">/</span><span><%= s.nav.presence || entry.title %></span></p>
      <h1 class="h-hero"><%= gl_heading(s.h) %></h1>
      <p class="lede"><%= s.lede %></p>
      <div class="hero-links">
        <%= gl_button s.audit.cta, "#audit", cta: "#{entry.slug}-hero-primary" %>
        <%= gl_button "See how we deliver it", "/how-it-works", variant: :ghost, cta: "#{entry.slug}-hero-secondary" %>
      </div>
    </div>
    <% if s.capabilities.any? %>
      <ul class="page-hero-row check-list is-two" data-stagger>
        <% s.capabilities.each do |c| %><li class="reveal"><%= c %></li><% end %>
      </ul>
    <% end %>
  </div>
</section>

<%= gl_section(tone: "subtle", rule: true) do %>
  <%= render "website/shared/numbered_list", eyebrow: "What this fixes", heading: "Said on the first call, ^nearly every time.^", quoted: true, items: s.problems.map { |p| [p.t, p.d] } %>
<% end %>

<%= gl_section do %>
  <div class="section-head reveal">
    <%= gl_eyebrow("How the work runs") %>
    <h2 class="h-2"><%= gl_heading(s.promise) %></h2>
  </div>
  <%= render "website/shared/steps", items: s.process.each_with_index.map { |p, i| [gl_n(i), p.t, p.d] }, columns: "4" %>
<% end %>

<%= gl_section(tone: "ink") do %>
  <div class="feature-row">
    <div class="feature-copy reveal">
      <%= gl_eyebrow(s.platform["name"]) %>
      <h2 class="h-2">The software behind it, <span class="em">not the software you buy.</span></h2>
      <p class="lede"><%= s.platform.d %></p>
      <% if s.human.present? %><div class="callout-box" style="margin-top:24px"><h3 class="h-4">Where the person sits</h3><p><%= s.human %></p></div><% end %>
      <div class="btn-row"><a class="btn-link" href="/trust">What never runs on its own <span class="arrow" aria-hidden="true">→</span></a></div>
    </div>
    <% if s.platform.image.present? %>
      <div class="feature-media reveal" style="--i:1"><%= render "website/shared/screen", image: s.platform.image, caption: s.platform.caption, browser: true %></div>
    <% end %>
  </div>
<% end %>

<%= render layout: "website/shared/case_studies", locals: {studies: gl_cases(s.cases), eyebrow: "Results", heading: "Where this is running today.",
  body: "Every figure comes from the live site or its sitemap at capture time. Where a client's performance data is theirs to release, we ask first and publish the baseline and the method with it.",
  link_label: "All %{count} case studies", tone: "subtle"} do %><% end %>

<% if next_service || others.any? %>
  <%= gl_section do %>
    <div class="two-col">
      <div class="reveal">
        <%= gl_eyebrow("What's next door") %>
        <h2 class="h-2"><%= entry.title %> hands off to <span class="em"><%= next_service&.title || "the rest." %><%= "." if next_service %></span></h2>
        <% if s.handoff.d.present? %><p class="lede"><%= s.handoff.d %></p><% end %>
      </div>
      <div class="steps is-two reveal" style="--i:1">
        <% others.each do |other| %>
          <% o = website_fields(other) %>
          <a href="<%= website_path(other) %>" data-cta="<%= entry.slug %>-related-<%= other.slug %>" class="step">
            <p class="step-when"><%= o.nav.presence || other.title %></p>
            <h3 class="h-4"><%= o.promise %></h3>
          </a>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

<% if s.faqs.any? %>
  <%= render "website/shared/faq", items: s.faqs.map { |f| Struct.new(:question, :answer).new(f.q, f.a) }, heading: "Questions about #{(s.nav.presence || entry.title).downcase}." %>
<% end %>

<%= render "website/shared/audit_section", heading: "#{s.audit.cta}.", blurb: s.audit.blurb, audit_type: s.audit.type,
  bullets: ["Read-only access. Nothing changes.", "No obligation, no slide deck.", "A person walks you through it."] %>
<%= tag.div(hidden: true, data: {gl_event: {event: "view_service", service_name: entry.title, service_slug: entry.slug}.to_json}) %>
