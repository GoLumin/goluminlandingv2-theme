<%# locals: (entry:) -%>
<%# A post: kicker, headline, standfirst, byline and reading time; the banner art; the prose and its figures (the entry's blocks, else its Markdown) beside a contact form; the plan form; two more posts. %>
<% f = website_fields(entry) %>
<% words = entry.body_markdown.to_s.split.size %>
<% minutes = [1, (words / 220.0).ceil].max %>
<% updated = f.updated_date.present? && (Time.zone.parse(f.updated_date.to_s) rescue nil) %>
<% posts = gl_posts %>
<% more = posts.sort_by(&:slug).reject { |p| p == entry }.first(2) %>
<% content_for :head do %>
  <%= gl_seo_tags(entry, title: entry.seo.to_h["meta_title"].presence || "#{entry.title} | #{gl_name}", description: f.description, image: f.share_image) %>
  <script nonce="<%= content_security_policy_nonce %>">try { if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("fig-motion") } catch (e) {}</script>
<% end %>
<% content_for :sticky_cta, "Request an audit" %>
<section class="page-hero is-night is-short">
  <%= render "website/shared/scene" %>
  <div class="container">
    <div class="page-hero-inner">
      <%= render "website/shared/badge" %>
      <p class="breadcrumb"><a href="/blog">Blog</a><% if f.eyebrow.present? %><span aria-hidden="true">/</span><span><%= f.eyebrow %></span><% end %></p>
      <h1 class="h-hero" style="font-size:clamp(34px,4.6vw,54px)"><%= entry.title %></h1>
      <% if f.lede.present? %><p class="lede"><%= f.lede %></p><% end %>
      <div class="blog-meta">
        <span><%= f.author.presence || gl_name %></span>
        <time datetime="<%= entry.published_at&.iso8601 %>"><%= entry.published_at&.strftime("%B %-d, %Y") %></time>
        <span><%= minutes %> min read</span>
        <% if updated %><span>Updated <%= updated.strftime("%B %-d, %Y") %></span><% end %>
      </div>
    </div>
  </div>
</section>
<% if f.art.present? %>
  <section class="section-tight"><div class="container"><div class="screen reveal"><%= gl_image f.art, alt: "", sizes: "(min-width: 72rem) 70rem, 100vw", loading: :eager, fetchpriority: :high %></div></div></section>
<% end %>
<section class="section-tight section-line">
  <div class="container prose-grid">
    <article class="post">
      <% if Array(entry.blocks).any? %>
        <% content_for :gl_in_post, "true" %>
        <%= website_blocks entry %>
      <% else %>
        <%= website_markdown entry.body_markdown %>
      <% end %>
    </article>
    <aside class="sticky-side">
      <div class="side-card">
        <h2 class="form-title">Let's talk</h2>
        <%= render "website/shared/contact_form", prefix: "blog-side" %>
      </div>
    </aside>
  </div>
</section>
<%= render "website/shared/audit_section", heading: "We'll tell you how many of your ads ^passed review.^", blurb: "Read-only access to the ad account, and real findings written down, with the money attached.", audit_type: "Ad account", prefix: "blog", bullets: [] %>
<% if more.any? %>
  <%= gl_section(tight: true) do %>
    <%= gl_eyebrow("More reading") %>
    <ul class="ruled">
      <% more.each do |post| %>
        <li><a href="<%= website_path(post) %>" style="color:var(--ink)"><span class="h-4"><%= post.title %></span><% if website_fields(post).eyebrow.present? %> <span class="small">· <%= website_fields(post).eyebrow %></span><% end %></a></li>
      <% end %>
    </ul>
  <% end %>
<% end %>
