<%# locals: (data:) -%>
<%# A heading and its standfirst, with a callout beside them. %>
<%= gl_section do %>
  <div class="two-col">
    <div class="reveal">
      <%= gl_eyebrow(data.eyebrow) %>
      <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
      <% if data.body.present? %><p class="lede"><%= data.body %></p><% end %>
    </div>
    <div class="reveal" style="--i:1">
      <div class="callout-box">
        <% if data.callout_label.present? %><h3 class="h-4"><%= data.callout_label %></h3><% end %>
        <p><%= data.callout_body %></p>
      </div>
      <% if data.footnote.present? %><p class="note"><%= data.footnote %></p><% end %>
    </div>
  </div>
<% end %>
