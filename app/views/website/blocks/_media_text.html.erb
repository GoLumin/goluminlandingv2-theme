<%# locals: (data:) -%>
<%# A feature row: the heading and its Markdown (paragraphs read as the standfirst, a list as the check list) beside the image. Background "accent" is the dark night section, with the image in a browser frame; "muted" the soft one. %>
<% href = gl_href(data.cta_url) %>
<% tone = {"muted" => "subtle", "accent" => "ink"}.fetch(data.background.to_s, "bg") %>
<%= gl_section(tone:) do %>
  <div class="feature-row<%= " is-flipped" if data.side == "left" %>">
    <div class="feature-copy reveal">
      <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
      <div class="media-body"><%= website_markdown data.body %></div>
      <% if href %><div class="btn-row"><%= gl_button data.cta_label.presence || "Learn more", href, variant: (tone == "ink" ? :outline : :primary) %></div><% end %>
    </div>
    <% if data.image_id.present? %>
      <div class="feature-media reveal" style="--i:1"><%= render "website/shared/screen", image: data.image_id, browser: tone == "ink" %></div>
    <% end %>
  </div>
<% end %>
