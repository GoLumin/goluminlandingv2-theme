<%# locals: (data:) -%>
<%# The dark close: the offer restated, the phone, and the plan form again. %>
<% phone = gl_href(data.phone_link) || gl_tel %>
<section class="section section-night has-photo" id="contact">
  <%= render "website/shared/scene", key: "closing", night: true %>
  <div class="container cta-grid">
    <div class="reveal">
      <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
      <% if data.blurb.present? %><p class="lede"><%= data.blurb %></p><% end %>
      <a class="cta-call" href="<%= phone %>" data-cta="closing-phone">
        <small><%= data.phone_kicker.presence || "Call us direct" %></small>
        <strong><%= data.phone_label.presence || gl_phone %></strong>
      </a>
    </div>
    <div class="reveal" style="--i:1">
      <%= render "website/shared/audit_form", prefix: "closing", cta: "closing-form", heading: "Tell us about the business", submit_label: data.submit_label, note: data.note, phone_href: phone, phone_label: data.phone_label %>
    </div>
  </div>
</section>
