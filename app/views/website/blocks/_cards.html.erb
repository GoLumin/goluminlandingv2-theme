<%# locals: (data:) -%>
<%# Cards under a heading. White or soft: two columns as the plan-style list, three or four as the step cards. Dark (tone ink): the tiles of the night section; with no heading, its body is the closing line under the tiles instead. numbered puts 01, 02… where a card has no kicker. Optionally the service links under them. %>
<% ink = data.tone == "ink" %>
<% kicker = ->(card, i) { card.kicker.presence || (gl_n(i) if data.numbered) } %>
<%= gl_section(tone: data.tone) do %>
  <% if data.heading.present? || data.eyebrow.present? %>
    <div class="section-head reveal">
      <%= gl_eyebrow(data.eyebrow) %>
      <% if data.heading.present? %><h2 class="h-2"><%= gl_heading(data.heading) %></h2><% end %>
      <% if data.body.present? && data.heading.present? %><p class="lede"><%= data.body %></p><% end %>
    </div>
  <% end %>
  <% if ink %>
    <div class="tile-grid<%= " is-first" if data.heading.blank? %>" data-stagger>
      <% data.items.each_with_index do |card, i| %>
        <div class="tile reveal">
          <% if (k = kicker.(card, i)).present? %><p class="tile-kicker"><%= k %></p><% end %>
          <h3 class="h-4"><%= card.title %></h3>
          <p><%= card.body %></p>
        </div>
      <% end %>
    </div>
    <% if data.heading.blank? && data.body.present? %><p class="ops-point reveal"><%= data.body %></p><% end %>
  <% elsif data.columns.to_s == "2" %>
    <div class="plan-list is-two" data-stagger>
      <% data.items.each_with_index do |card, i| %>
        <div class="plan-item reveal">
          <% if (k = kicker.(card, i)).present? %><p class="step-when"><%= k %></p><% end %>
          <h3 class="h-4"><%= card.title %></h3>
          <p><%= card.body %></p>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="steps<%= " is-four" if data.columns.to_s == "4" %>" data-stagger>
      <% data.items.each_with_index do |card, i| %>
        <div class="step reveal">
          <% if (k = kicker.(card, i)).present? %><p class="step-when"><%= k %></p><% end %>
          <h3 class="h-4"><%= card.title %></h3>
          <p><%= card.body %></p>
        </div>
      <% end %>
    </div>
  <% end %>
  <% if data.service_links && gl_services.any? %>
    <div class="steps mt-section" data-stagger>
      <% gl_services.each do |service| %>
        <% s = website_fields(service) %>
        <a href="<%= website_path(service) %>" data-cta="services-index-<%= service.slug %>" class="step reveal">
          <h3 class="h-4"><%= s.nav.presence || service.title %> <span aria-hidden="true">→</span></h3>
          <p><%= s.promise %></p>
        </a>
      <% end %>
    </div>
  <% end %>
<% end %>
