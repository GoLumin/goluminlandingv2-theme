<%# locals: (data:) -%>
<%# Bordered cards in two or three columns: how to start, what we select for, the referral deal (dark). Optionally the service links under them. %>
<% ink = data.tone == "ink" %>
<%= gl_section(tone: data.tone) do %>
  <div class="<%= ink ? "max-w-4xl" : "max-w-3xl" %>">
    <% if ink %>
      <%= gl_pulse_eyebrow(data.eyebrow) %>
    <% else %>
      <%= gl_eyebrow(data.eyebrow, data.eyebrow_n) %>
    <% end %>
    <h2 class="reveal display display-lg"><%= gl_heading(data.heading) %></h2>
    <% if data.body.present? %><p class="<%= class_names("reveal text-lg leading-snug text-text-subtle", "mt-8 max-w-2xl": ink, "mt-6": !ink) %>"><%= data.body %></p><% end %>
  </div>
  <div class="<%= class_names("mt-12 grid gap-6", "md:grid-cols-3": data.columns != "2", "md:grid-cols-2": data.columns == "2") %>" data-stagger>
    <% data.items.each_with_index do |card, i| %>
      <div class="reveal border-2 border-text bg-surface p-6">
        <% if data.numbered %>
          <span class="tag font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted"><%= gl_n(i) %></span>
        <% elsif card.kicker.present? %>
          <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted"><%= card.kicker %></span>
        <% end %>
        <h3 class="mt-3 text-2xl font-bold tracking-tight"><%= card.title %></h3>
        <p class="mt-3 text-[15px] leading-snug text-text-subtle"><%= card.body %></p>
      </div>
    <% end %>
  </div>
  <% if data.service_links %>
    <div class="mt-12 grid gap-4 sm:grid-cols-3" data-stagger>
      <% gl_services.each do |service| %>
        <% s = website_fields(service) %>
        <a href="<%= website_path(service) %>" data-cta="services-index-<%= service.slug %>" class="reveal lift group flex items-center justify-between gap-3 border-2 border-text bg-bg-subtle px-5 py-4">
          <span>
            <span class="block font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted"><%= s.n %></span>
            <span class="mt-1 block text-lg font-semibold tracking-tight"><%= s.nav %></span>
          </span>
          <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      <% end %>
    </div>
  <% end %>
<% end %>
