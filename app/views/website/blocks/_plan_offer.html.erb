<%# locals: (data:) -%>
<%# The free marketing plan, and the free landing page if they hire us (the Ad landing pages global). %>
<% ad = gl_global(:ad_landing) %>
<%= gl_section(id: "offer") do %>
  <div class="grid items-start gap-10 lg:grid-cols-[1fr_1fr] lg:gap-14">
    <div>
      <%= gl_eyebrow(data.eyebrow, data.eyebrow_n) %>
      <h2 class="display display-md"><%= ad.plan.headline %></h2>
      <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-text-subtle"><%= ad.plan.sub %></p>
      <ul class="mt-8 space-y-5">
        <% ad.plan.keep.each do |item| %>
          <li class="border-l-2 border-primary pl-5"><p class="text-[16px] font-bold tracking-tight"><%= item.t %></p><p class="mt-1.5 text-[15px] leading-relaxed text-text-subtle"><%= item.d %></p></li>
        <% end %>
      </ul>
      <p class="mt-8 text-[17px] font-semibold"><span class="mark"><%= ad.plan.refrain %></span></p>
    </div>
    <div class="border-2 border-text bg-surface p-6 md:p-8">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted"><%= data.offer_label %></p>
      <p class="mt-3 text-3xl font-bold leading-tight tracking-tight"><%= ad.offer.headline %></p>
      <p class="mt-3 text-[15px] leading-relaxed text-text-subtle"><%= ad.offer.sub %></p>
      <ul class="mt-6 space-y-4 border-t-2 border-border pt-6">
        <% ad.offer.includes.each do |item| %>
          <li><p class="text-[15px] font-bold tracking-tight"><%= item.t %></p><p class="mt-1 text-[14px] leading-relaxed text-text-subtle"><%= item.d %></p></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
