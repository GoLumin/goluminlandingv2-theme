<%# locals: (data:) -%>
<%# The free marketing plan: what you keep (the Ad landing pages global's plan), and the free landing page that comes with an account (its offer). %>
<% ad = gl_global(:ad_landing) %>
<%= gl_section(id: "offer") do %>
  <div class="plan-grid">
    <div class="reveal">
      <%= gl_eyebrow(data.eyebrow) %>
      <h2 class="h-2"><%= gl_heading(ad.plan.headline) %></h2>
      <% if ad.plan.sub.present? %><p class="lede"><%= ad.plan.sub %></p><% end %>
      <% if ad.plan.refrain.present? %><p class="note"><%= ad.plan.refrain %></p><% end %>
    </div>
    <div class="plan-list reveal" style="--i:1">
      <% ad.plan.keep.each do |item| %>
        <div class="plan-item"><h3 class="h-4"><%= item.t %></h3><p><%= item.d %></p></div>
      <% end %>
    </div>
  </div>
  <% if ad.offer.headline.present? %>
    <div class="list-card reveal mt-section">
      <%= gl_eyebrow(data.offer_label) %>
      <h3 class="h-3"><%= ad.offer.headline %></h3>
      <p class="lede" style="margin-top:10px"><%= ad.offer.sub %></p>
      <% if ad.offer.includes.any? %>
        <ul class="check-list is-two">
          <% ad.offer.includes.each do |item| %><li><strong><%= item.t %></strong> <%= item.d %></li><% end %>
        </ul>
      <% end %>
    </div>
  <% end %>
<% end %>
