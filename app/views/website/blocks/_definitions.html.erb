<%# locals: (data:) -%>
<%# Terms and their answers beside the heading: a ruled list. %>
<%= gl_section(tone: data.tone) do %>
  <div class="plan-grid">
    <div class="reveal">
      <%= gl_eyebrow(data.eyebrow) %>
      <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
      <% if data.body.present? %><p class="lede"><%= data.body %></p><% end %>
    </div>
    <dl class="ruled reveal" style="--i:1">
      <% data.items.each do |item| %>
        <div><dt class="h-4"><%= item.term %></dt><dd><p><%= item.body %></p></dd></div>
      <% end %>
    </dl>
  </div>
<% end %>
