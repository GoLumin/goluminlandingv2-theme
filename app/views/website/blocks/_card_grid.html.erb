<%# locals: (data:) -%>
<%= gl_section do %>
  <% if data.heading.present? %><h2 class="reveal display display-lg max-w-3xl"><%= gl_heading(data.heading) %></h2><% end %>
  <% if data.body.present? %><p class="reveal mt-6 max-w-2xl text-lg leading-snug text-text-subtle"><%= website_plain_text(data.body) %></p><% end %>
  <div class="mt-12 grid gap-6 <%= {"2" => "md:grid-cols-2", "4" => "md:grid-cols-2 lg:grid-cols-4"}.fetch(data.columns.to_s, "md:grid-cols-3") %>" data-stagger>
    <% data.cards.each do |card| %>
      <% href = gl_href(card.link_url) %>
      <div class="reveal flex flex-col border-2 border-text bg-surface">
        <% if card.image_id.present? %><%= gl_image card.image_id, sizes: "(min-width: 768px) 33vw, 100vw", class: "block aspect-[16/10] w-full border-b-2 border-text object-cover" %><% end %>
        <div class="flex grow flex-col p-6">
          <% if card.subtitle.present? %><span class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted"><%= card.subtitle %></span><% end %>
          <h3 class="mt-2 text-2xl font-bold tracking-tight"><%= card.title %></h3>
          <p class="mt-3 text-[15px] leading-snug text-text-subtle"><%= website_plain_text(card.description) %></p>
          <% if href %><a href="<%= href %>" class="mt-auto pt-5 font-semibold underline decoration-2 decoration-signal underline-offset-[6px] hover:decoration-text"><%= card.link_label.presence || "Learn more" %> →</a><% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
