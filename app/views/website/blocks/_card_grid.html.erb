<%# locals: (data:) -%>
<%# A grid of cards. Converted from the old utility classes to the Method
    system's own vocabulary (see "CMS blocks, in the Method system" in
    method.css); the block's fields and behaviour are unchanged. %>
<%= gl_section do %>
  <div class="section-head">
    <% if data.heading.present? %><h2 class="reveal h-2"><%= gl_heading(data.heading) %></h2><% end %>
    <% if data.body.present? %><p class="reveal lede"><%= website_plain_text(data.body) %></p><% end %>
  </div>
  <div class="cardgrid<%= {"2" => " is-2", "4" => " is-4"}[data.columns.to_s] %>" data-stagger>
    <% data.cards.each do |card| %>
      <% href = gl_href(card.link_url) %>
      <div class="reveal card">
        <% if card.image_id.present? %><%= gl_image card.image_id, sizes: "(min-width: 768px) 33vw, 100vw", class: "card-media" %><% end %>
        <div class="card-body">
          <% if card.subtitle.present? %><span class="card-kicker"><%= card.subtitle %></span><% end %>
          <h3 class="h-4"><%= card.title %></h3>
          <p><%= website_plain_text(card.description) %></p>
          <% if href %><a href="<%= href %>" class="card-link btn-link"><%= card.link_label.presence || "Learn more" %> &rarr;</a><% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
