<%# locals: (data:) -%>
<%# What never happens without a person, and what runs on its own. %>
<%= gl_section(tone: "subtle", id: "trust", rule: true) do %>
  <div class="section-head reveal">
    <%= gl_eyebrow(data.eyebrow) %>
    <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
  </div>
  <div class="split-lists" data-stagger>
    <div class="list-card is-never reveal">
      <h3 class="h-4"><%= data.never_label %></h3>
      <ul><% data.never.each do |line| %><li><%= line %></li><% end %></ul>
    </div>
    <div class="list-card reveal">
      <h3 class="h-4"><%= data.always_label %></h3>
      <ul><% data.always.each do |line| %><li><%= line %></li><% end %></ul>
    </div>
  </div>
  <% if data.note.present? %><p class="note reveal"><%= data.note %></p><% end %>
<% end %>
