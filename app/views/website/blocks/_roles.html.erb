<%# locals: (data:) -%>
<%# Every open role, in full, from the roles collection: what you'd own and work with, what we need, the honest part. Alternating tones. %>
<% apply = gl_href(data.apply_link) %>
<% gl_roles.each_with_index do |role, idx| %>
  <% r = website_fields(role) %>
  <%= gl_section(tone: idx.even? ? "bg" : "subtle", id: role.slug, rule: true) do %>
    <div class="two-col">
      <div class="sticky-side reveal">
        <%= gl_eyebrow([r.team, data.location].compact_blank.join(" · ")) %>
        <h2 class="h-2"><%= role.title %></h2>
        <% if r.promise.present? %><p class="lede" style="margin-top:14px;color:var(--violet)"><%= r.promise %></p><% end %>
        <% if r.lede.present? %><p class="lede" style="margin-top:14px"><%= r.lede %></p><% end %>
        <% if r.chips.any? %><div class="role-chips"><% r.chips.each do |chip| %><span class="chip"><%= chip %></span><% end %></div><% end %>
        <% if apply %><div class="btn-row" style="margin-top:28px"><%= gl_button data.apply_label, apply, cta: "role-apply-#{role.slug}" %></div><% end %>
      </div>
      <div class="stack reveal" style="--i:1">
        <% if r.owns.any? %>
          <div><p class="eyebrow">What you'd own</p><ul class="dash-list"><% r.owns.each do |line| %><li><%= gl_dot %><span><%= line %></span></li><% end %></ul></div>
        <% end %>
        <% if r.stack.any? %>
          <div class="mt-section"><p class="eyebrow">What you'd work with</p>
            <dl class="ruled"><% r.stack.each do |s| %><div><dt class="h-4"><%= s.t %></dt><dd><p><%= s.d %></p></dd></div><% end %></dl>
          </div>
        <% end %>
        <div class="two-col is-even mt-section">
          <% if r.need.any? %><div><p class="eyebrow">What we need</p><ul class="dash-list"><% r.need.each do |line| %><li><%= gl_dot %><span><%= line %></span></li><% end %></ul></div><% end %>
          <% if r.bonus.any? %><div><p class="eyebrow">Helps, never required</p><ul class="dash-list"><% r.bonus.each do |line| %><li><%= gl_dot %><span><%= line %></span></li><% end %></ul></div><% end %>
        </div>
        <% if r.honest.present? %><div class="callout-box mt-section"><h3 class="h-4">The honest part</h3><p><%= r.honest %></p></div><% end %>
        <% if r.growth.present? %><div class="callout-box"><h3 class="h-4">Where it goes</h3><p><%= r.growth %></p></div><% end %>
      </div>
    </div>
  <% end %>
<% end %>
