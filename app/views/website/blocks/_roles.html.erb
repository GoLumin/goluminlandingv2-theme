<%# locals: (data:) -%>
<%# Every open role, in full (careers.astro), from the roles collection: what you'd own and work with, what we need, the honest part. Alternating tones. %>
<% apply = gl_href(data.apply_link) %>
<% gl_roles.each_with_index do |role, idx| %>
  <% r = website_fields(role) %>
  <%= gl_section(tone: idx.even? ? "bg" : "subtle", id: role.slug, klass: "scroll-mt-20") do %>
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
      <div class="lg:sticky lg:top-24">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[12px] uppercase tracking-[0.18em]">
          <span class="tag text-text-muted"><%= r.n %></span>
          <span class="font-semibold text-text"><%= r.team %></span>
          <span class="text-text-muted">· <%= data.location %></span>
        </div>
        <h2 class="reveal display display-md mt-5"><%= role.title %></h2>
        <p class="reveal mt-4 text-xl font-semibold leading-snug tracking-tight text-primary"><%= r.promise %></p>
        <p class="reveal mt-5 max-w-lg text-[17px] leading-snug text-text-subtle"><%= r.lede %></p>
        <div class="mt-7 flex flex-wrap gap-2 font-mono text-[11px] uppercase tracking-wider">
          <% r.chips.each do |chip| %><span class="border border-text px-2 py-1 text-text"><%= chip %></span><% end %>
        </div>
        <% if apply %><div class="mt-8"><%= gl_button data.apply_label, apply, magnet: true, cta: "role-apply-#{role.slug}" %></div><% end %>
      </div>
      <div data-stagger>
        <div class="reveal">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted">What you'd own</p>
          <ul class="mt-4 rule-t">
            <% r.owns.each do |line| %><li class="flex items-start gap-3 border-b border-border py-3 text-[15px] font-medium leading-snug"><%= gl_dot %><%= line %></li><% end %>
          </ul>
        </div>
        <div class="reveal mt-10">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted">What you'd work with</p>
          <dl class="mt-4 rule-t">
            <% r.stack.each do |s| %>
              <div class="border-b border-border py-3.5">
                <dt class="text-[15px] font-semibold tracking-tight"><%= s.t %></dt>
                <dd class="mt-1 text-[14.5px] leading-snug text-text-subtle"><%= s.d %></dd>
              </div>
            <% end %>
          </dl>
        </div>
        <div class="reveal mt-10 grid gap-8 sm:grid-cols-2">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted">What we need</p>
            <ul class="mt-4 space-y-2.5">
              <% r.need.each do |line| %><li class="flex items-start gap-2.5 text-[14.5px] font-medium leading-snug"><span class="mt-[2px] shrink-0 font-mono text-signal" aria-hidden="true">→</span><%= line %></li><% end %>
            </ul>
          </div>
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted">Helps, never required</p>
            <ul class="mt-4 space-y-2.5">
              <% r.bonus.each do |line| %><li class="flex items-start gap-2.5 text-[14.5px] leading-snug text-text-subtle"><span class="mt-[2px] shrink-0 font-mono text-text-muted" aria-hidden="true">+</span><%= line %></li><% end %>
            </ul>
          </div>
        </div>
        <div class="reveal mt-10 border-l-2 border-signal bg-bg-subtle px-5 py-4">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted">The honest part</p>
          <p class="mt-2 text-[15px] leading-snug"><%= r.honest %></p>
        </div>
        <div class="reveal mt-4 border-l-2 border-text bg-surface px-5 py-4">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted">Where it goes</p>
          <p class="mt-2 text-[15px] leading-snug"><%= r.growth %></p>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
