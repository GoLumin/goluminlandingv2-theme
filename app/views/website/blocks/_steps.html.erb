<%# locals: (data:) -%>
<%# A row of step cards under a heading: what happens next, the hiring process, the worked example (figures: the kicker set large). %>
<%= gl_section(tone: data.tone, id: data.anchor) do %>
  <% if data.heading.present? || data.eyebrow.present? %>
    <div class="section-head reveal">
      <%= gl_eyebrow(data.eyebrow) %>
      <% if data.heading.present? %><h2 class="h-2"><%= gl_heading(data.heading) %></h2><% end %>
      <% if data.aside.present? %><p class="lede"><%= data.aside %></p><% end %>
    </div>
  <% end %>
  <%= render "website/shared/steps", items: data.items.map { |item| [item.kicker, item.title, item.body] }, columns: data.columns, figures: data.figures, h2: data.heading.blank? %>
  <% if data.note.present? %><p class="note steps-note reveal"><%= data.note %></p><% end %>
<% end %>
