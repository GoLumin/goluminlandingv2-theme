<%# locals: (data:) -%>
<%# The ways in: call us, email us, as two linked cards. %>
<%= gl_section(tight: true) do %>
  <%= gl_eyebrow(data.eyebrow, klass: "reveal") %>
  <div class="ways-grid" data-stagger>
    <% data.items.each_with_index do |card, i| %>
      <% href = gl_href(card.link) or next %>
      <a href="<%= href %>" data-cta="lets-talk-<%= i.zero? ? "phone" : "email" %>" class="way reveal">
        <small><%= card.kicker %></small>
        <strong><%= card.title %></strong>
        <p><%= card.body %></p>
      </a>
    <% end %>
  </div>
<% end %>
