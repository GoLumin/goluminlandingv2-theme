<%# locals: (data:) -%>
<%# The 404: the headline, the way home, the services (the services collection) and the rest of the site. %>
<section class="page-hero" data-not-found>
  <%= render "website/shared/scene" %>
  <div class="container">
    <div class="page-hero-inner">
      <%= render "website/shared/badge" %>
      <%= gl_eyebrow(data.eyebrow) %>
      <h1 class="h-hero"><%= gl_heading(data.heading) %></h1>
      <% if data.lede.present? %><p class="lede"><%= data.lede %></p><% end %>
      <% if data.ctas.any? %><div class="hero-links"><%= gl_ctas(data.ctas, cta: "404") %></div><% end %>
    </div>
    <% if gl_services.any? %>
      <ul class="page-hero-row steps" data-stagger>
        <% gl_services.each do |service| %>
          <li class="step reveal">
            <h2 class="h-4"><a href="<%= website_path(service) %>"><%= website_fields(service).nav.presence || service.title %></a></h2>
            <p><%= website_fields(service).promise %></p>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% if data.elsewhere.any? %>
      <nav class="page-hero-row" aria-label="Elsewhere on the site">
        <%= gl_eyebrow(data.elsewhere_label) %>
        <ul class="dash-list">
          <% data.elsewhere.each do |item| %>
            <% href = gl_href(item.link) or next %>
            <li><%= gl_dot %><span><a href="<%= href %>"><strong><%= item.label %></strong></a> <%= item.body %></span></li>
          <% end %>
        </ul>
      </nav>
    <% end %>
  </div>
</section>
