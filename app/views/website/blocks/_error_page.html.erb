<%# locals: (data:) -%>
<%# The 404 (404.astro): the headline, the way home, the three services (the services collection) and the rest of the site. %>
<section class="relative overflow-hidden" data-not-found>
  <div class="grid-paper pointer-events-none absolute inset-0 -z-10 opacity-70"></div>
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <p class="reveal mb-8 font-mono text-[12px] uppercase tracking-[0.18em] text-text-muted"><%= data.eyebrow %></p>
    <h1 class="reveal display display-xl max-w-4xl"><%= gl_heading(data.heading) %></h1>
    <p class="reveal mt-8 max-w-xl text-xl leading-snug text-text-subtle md:text-2xl"><%= data.lede %></p>
    <div class="reveal mt-8 flex flex-wrap items-center gap-3"><%= gl_ctas(data.ctas, cta: "404") %></div>
    <ul class="mt-14 grid rule-t md:grid-cols-3" data-stagger>
      <% gl_services.each do |service| %>
        <li class="reveal border-b-2 border-text py-6 md:border-b-0 md:border-r-2 md:pr-8 md:last:border-r-0 md:[&:not(:first-child)]:pl-8">
          <div class="tag font-mono text-[12px] text-text-muted"><%= website_fields(service).n %></div>
          <h2 class="mt-3 text-3xl font-bold tracking-tight"><a href="<%= website_path(service) %>" class="underline decoration-2 decoration-signal underline-offset-[6px] hover:decoration-text"><%= service.title %></a></h2>
          <p class="mt-2 text-[15px] leading-snug text-text-subtle"><%= website_fields(service).promise %></p>
        </li>
      <% end %>
    </ul>
    <nav class="mt-14 rule-t pt-6" aria-label="Elsewhere on the site">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted"><%= data.elsewhere_label %></p>
      <ul class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-2">
        <% data.elsewhere.each do |item| %>
          <% href = gl_href(item.link) or next %>
          <li>
            <a href="<%= href %>" class="group inline-flex flex-wrap items-baseline gap-x-2">
              <span class="font-semibold underline decoration-2 decoration-signal underline-offset-[6px] group-hover:decoration-text"><%= item.label %></span>
              <span class="text-[15px] leading-snug text-text-subtle"><%= item.body %></span>
            </a>
          </li>
        <% end %>
      </ul>
    </nav>
  </div>
</section>
