<%# locals: (data:) -%>
<%# A form beside its pitch: the application (careers), the referral form or the short contact form. %>
<%= gl_section(tone: data.tone, id: data.anchor) do %>
  <div class="cta-grid">
    <div class="reveal">
      <%= gl_eyebrow(data.eyebrow) %>
      <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
      <% if data.body.present? %><p class="lede"><%= data.body %></p><% end %>
      <% if data.bullets.any? %><ul class="check-list"><% data.bullets.each do |bullet| %><li><%= bullet %></li><% end %></ul><% end %>
      <% if data.footnote.present? %><%= render "website/shared/inline_markdown", text: data.footnote, klass: "note" %><% end %>
    </div>
    <div class="reveal" style="--i:1">
      <% if data.form == "application" %><%= render "website/shared/apply_form" %>
      <% elsif data.form == "referral" %><%= render "website/shared/referral_form" %>
      <% elsif data.form == "contact" %><div class="form-card"><%= render "website/shared/contact_form", prefix: "contact" %></div>
      <% end %>
    </div>
  </div>
<% end %>
