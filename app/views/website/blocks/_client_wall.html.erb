<%# locals: (data:) -%>
<%# Every client cleared for public mention (the clients collection): the name, what we run, and the fact. %>
<%= gl_section(tone: "subtle", id: "clients", rule: true) do %>
  <div class="section-head reveal">
    <%= gl_eyebrow(data.eyebrow) %>
    <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
  </div>
  <div class="plan-list is-two" data-stagger>
    <% gl_clients.each do |client| %>
      <% c = website_fields(client) %>
      <div class="plan-item reveal">
        <p class="step-when"><%= [c.vertical, c.what].compact_blank.join(" · ") %></p>
        <h3 class="h-4"><%= client.title %></h3>
        <% if c.fact.present? %><p><%= c.fact %></p><% end %>
      </div>
    <% end %>
  </div>
<% end %>
