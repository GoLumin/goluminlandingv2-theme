<%# locals: (data:) -%>
<%# Every published client and what we did for them (the clients collection). %>
<%= gl_section(tone: "subtle") do %>
  <%= gl_eyebrow(data.eyebrow, data.eyebrow_n) %>
  <h2 class="display display-md max-w-3xl"><%= gl_heading(data.heading) %></h2>
  <div class="mt-10 grid items-start gap-px border-2 border-text bg-border sm:grid-cols-2 lg:grid-cols-3">
    <% gl_clients.each do |client| %>
      <% c = website_fields(client) %>
      <div class="flex h-full flex-col bg-surface p-5">
        <p class="text-[15px] font-bold tracking-tight"><%= client.title %></p>
        <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.12em] text-text-muted"><%= c.vertical %></p>
        <p class="mt-3 text-[14px] leading-relaxed text-text-subtle"><%= c.fact %></p>
      </div>
    <% end %>
  </div>
<% end %>
