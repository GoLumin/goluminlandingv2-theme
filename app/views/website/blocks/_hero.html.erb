<%# locals: (data:) -%>
<%# The core hero, under the light, with its image beside the copy. %>
<section class="<%= data.image_id.present? ? "hero" : "page-hero" %>">
  <div class="hero-light" aria-hidden="true"></div>
  <%= render "website/shared/hero_photo" %>
  <div class="container <%= data.image_id.present? ? "hero-grid" : "" %>">
    <div class="<%= data.image_id.present? ? "hero-copy" : "page-hero-inner" %>">
      <h1 class="h-hero"><%= gl_heading(data.heading) %></h1>
      <% if data.subheading.present? %><p class="lede"><%= website_plain_text(data.subheading) %></p><% end %>
      <% if data.ctas.any? %><div class="hero-links"><%= gl_ctas(data.ctas, cta: "hero") %></div><% end %>
    </div>
    <% if data.image_id.present? %><div class="reveal"><%= render "website/shared/screen", image: data.image_id, eager: true %></div><% end %>
  </div>
</section>
