<%# locals: (data:) -%>
<%# Markdown: a run of a post's prose (inside the post's column), or a plain section of text on a page. %>
<% if content_for?(:gl_in_post) %>
  <div class="post-text"><%= website_markdown data.body %></div>
<% else %>
  <section class="section-tight"><div class="container-narrow post"><%= website_markdown data.body %></div></section>
<% end %>
