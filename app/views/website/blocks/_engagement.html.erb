<%# locals: (data:) -%>
<%# What to expect (Engagement.astro): the first two weeks, phase by phase, and the four answers under them. %>
<%= gl_section(id: "engagement") do %>
  <%= render "website/shared/section_head", data: %>
  <ol class="mt-12 grid rule-t md:grid-cols-3" data-stagger>
    <% data.phases.each do |phase| %>
      <li class="reveal border-b-2 border-text py-6 md:border-b-0 md:border-r-2 md:pr-8 md:last:border-r-0 md:[&:not(:first-child)]:pl-8">
        <div class="tag font-mono text-[12px] text-text-muted"><%= phase.when %></div>
        <h3 class="mt-3 text-3xl font-bold tracking-tight"><%= phase.title %></h3>
        <p class="mt-2 text-[15px] leading-snug text-text-subtle"><%= phase.body %></p>
        <ul class="mt-5 space-y-2">
          <% phase.items.each do |item| %><li class="flex items-start gap-2.5 text-[14px] font-medium leading-snug"><span class="mt-[6px] h-1.5 w-1.5 shrink-0 bg-signal" aria-hidden="true"></span><%= item %></li><% end %>
        </ul>
      </li>
    <% end %>
  </ol>
  <dl class="mt-14 grid gap-x-10 gap-y-6 border-t border-border pt-10 sm:grid-cols-2" data-stagger>
    <% data.answers.each do |answer| %>
      <div class="reveal">
        <dt class="text-lg font-semibold tracking-tight"><%= answer.question %></dt>
        <dd class="mt-1.5 text-[15px] leading-snug text-text-subtle"><%= answer.answer %></dd>
      </div>
    <% end %>
  </dl>
<% end %>
