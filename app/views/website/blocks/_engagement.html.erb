<%# locals: (data:) -%>
<%# What to expect: the phases as step cards (when, title, body, its points), then the questions people ask at that point. %>
<%= gl_section(tone: "subtle", id: "engagement", rule: true) do %>
  <div class="section-head reveal">
    <%= gl_eyebrow(data.eyebrow) %>
    <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
  </div>
  <ol class="steps" data-stagger>
    <% data.phases.each do |phase| %>
      <li class="step reveal">
        <% if phase.when.present? %><p class="step-when"><%= phase.when %></p><% end %>
        <h3 class="h-4"><%= phase.title %></h3>
        <p><%= phase.body %></p>
        <% if phase.items.any? %><ul><% phase.items.each do |line| %><li><%= line %></li><% end %></ul><% end %>
      </li>
    <% end %>
  </ol>
  <% if data.answers.any? %>
    <div class="faq-list reveal mt-section">
      <% data.answers.each do |item| %>
        <details class="faq"><summary><%= item.question %></summary><div class="faq-body"><div><p><%= item.answer %></p></div></div></details>
      <% end %>
    </div>
  <% end %>
<% end %>
