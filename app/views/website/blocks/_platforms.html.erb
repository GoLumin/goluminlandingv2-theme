<%# locals: (data:) -%>
<%# Feature rows under one heading: each item is a heading and standfirst, a check list of bullets and a screenshot in a browser frame, flipped where asked. Then the note, with its link. %>
<% link = gl_href(data.link) %>
<%= gl_section(id: "platform") do %>
  <% if data.heading.present? || data.eyebrow.present? %>
    <div class="section-head reveal">
      <%= gl_eyebrow(data.eyebrow) %>
      <% if data.heading.present? %><h2 class="h-2"><%= gl_heading(data.heading) %></h2><% end %>
      <% if data.body.present? %><p class="lede"><%= data.body %></p><% end %>
    </div>
  <% end %>
  <% data.items.each do |x| %>
    <div id="<%= x.anchor.presence %>" class="feature-row<%= " is-flipped" if x.flip %>">
      <div class="feature-copy reveal">
        <%= gl_eyebrow([x["name"], x.role].compact_blank.join(" · ")) %>
        <h2 class="h-2"><%= gl_heading(x.heading) %></h2>
        <% if x.body.present? %><p class="lede"><%= x.body %></p><% end %>
        <% if x.bullets.any? %>
          <ul class="check-list"><% x.bullets.each do |bullet| %><li><%= bullet %></li><% end %></ul>
        <% end %>
      </div>
      <div class="feature-media reveal" style="--i:1"><%= render "website/shared/screen", image: x.image, caption: x.caption, browser: true %></div>
    </div>
  <% end %>
  <% if data.note.present? %>
    <div class="service-underline reveal" style="margin-top:72px">
      <p><% if data.note_lead.present? %><strong><%= data.note_lead %></strong> <% end %><%= data.note %></p>
      <% if link && data.link_label.present? %><a class="btn-link" href="<%= link %>"><%= data.link_label.to_s.delete_suffix("→").strip %> <span class="arrow" aria-hidden="true">→</span></a><% end %>
    </div>
  <% end %>
<% end %>
