<%# locals: (data:) -%>
<%# What people say on the first call, as a two-column list beside the heading. %>
<%= gl_section(tone: "subtle", rule: true) do %>
  <div class="plan-grid">
    <div class="reveal">
      <%= gl_eyebrow(data.eyebrow) %>
      <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
    </div>
    <div class="plan-list reveal" style="--i:1">
      <% data.items.each do |item| %><div class="plan-item"><h3 class="h-4"><%= item.title %></h3><p><%= item.body %></p></div><% end %>
    </div>
  </div>
<% end %>
