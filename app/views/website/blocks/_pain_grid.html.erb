<%# locals: (data:) -%>
<%# Problems in a ruled grid (laspalmas.astro). %>
<%= gl_section(tone: "subtle") do %>
  <%= gl_eyebrow(data.eyebrow, data.eyebrow_n) %>
  <h2 class="display display-md max-w-3xl"><%= gl_heading(data.heading) %></h2>
  <div class="mt-10 grid items-start gap-px border-2 border-text bg-border md:grid-cols-2">
    <% data.items.each do |item| %>
      <div class="bg-surface p-6 md:p-7">
        <p class="text-[17px] font-bold leading-snug tracking-tight"><%= item.title %></p>
        <p class="mt-3 text-[15px] leading-relaxed text-text-subtle"><%= item.body %></p>
      </div>
    <% end %>
  </div>
<% end %>
