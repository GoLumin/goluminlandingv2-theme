<%# locals: (data:) -%>
<%# A page's opening under the light: eyebrow, headline, standfirst, chips and buttons. Its row underneath: the service's capabilities, the open roles (the roles collection) or the figures. "%{count}" in the eyebrow is the number of posts. %>
<% eyebrow = data.eyebrow.to_s.include?("%{count}") ? gl_count(data.eyebrow, "#{gl_posts.size} post#{"s" unless gl_posts.size == 1}") : data.eyebrow %>
<section class="page-hero is-night">
  <%= render "website/shared/scene" %>
  <div class="container">
    <div class="page-hero-inner">
      <%= render "website/shared/badge" %>
      <%= gl_eyebrow(eyebrow) %>
      <h1 class="h-hero"><%= gl_heading(data.heading) %></h1>
      <% if data.lede.present? %><p class="lede"><%= data.lede %></p><% end %>
      <% if data.chips.any? %>
        <div class="chips"><% data.chips.each do |chip| %><span class="chip"><%= chip %></span><% end %></div>
      <% end %>
      <% if data.ctas.any? %><div class="hero-links"><%= gl_ctas(data.ctas, cta: "page-hero") %></div><% end %>
    </div>
    <% if data.items_style == "roles" && gl_roles.any? %>
      <ul class="page-hero-row stat-row is-four" data-stagger>
        <% gl_roles.each do |role| %>
          <% r = website_fields(role) %>
          <li class="stat reveal">
            <a href="#<%= role.slug %>"><span class="h-4"><%= role.title %> <span aria-hidden="true">↓</span></span></a>
            <p><%= r.team %></p>
          </li>
        <% end %>
      </ul>
    <% elsif data.items_style == "figures" && data.items.any? %>
      <ul class="page-hero-row stat-row<%= " is-four" if data.items.size >= 4 %>" data-stagger>
        <% data.items.each do |item| %>
          <li class="stat reveal"><span class="num"><%= item.title %></span><p><%= item.note %></p></li>
        <% end %>
      </ul>
    <% elsif data.items_style == "capabilities" && data.items.any? %>
      <ul class="page-hero-row check-list is-two" data-stagger>
        <% data.items.each do |item| %><li class="reveal"><%= item.title %></li><% end %>
      </ul>
    <% end %>
  </div>
</section>
