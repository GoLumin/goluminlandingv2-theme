<%# locals: (data:) -%>
<%# A page's opening (ui/PageHero.astro), on the engineering-paper grid. Its ruled row: the service's capabilities, the open roles (the roles collection) or the referral figures. "%{count}" in the eyebrow is the number of posts. %>
<% eyebrow = data.eyebrow.to_s.include?("%{count}") ? gl_count(data.eyebrow, "#{gl_posts.size} post#{"s" unless gl_posts.size == 1}") : data.eyebrow %>
<section class="relative overflow-hidden">
  <div class="grid-paper pointer-events-none absolute inset-0 -z-10 opacity-70"></div>
  <div class="mx-auto max-w-6xl px-5 pb-12 pt-12 md:px-8 md:pb-16 md:pt-20">
    <p class="reveal mb-8 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[12px] uppercase tracking-[0.14em] sm:tracking-[0.18em]">
      <span class="pulse-dot relative inline-block h-2 w-2 rounded-full bg-signal"></span>
      <span class="font-semibold"><%= eyebrow %></span>
    </p>
    <h1 class="reveal display display-xl max-w-5xl"><%= gl_heading(data.heading) %></h1>
    <p class="reveal mt-8 max-w-2xl text-xl leading-snug text-text-subtle md:text-2xl"><%= data.lede %></p>
    <% if data.chips.any? %>
      <div class="reveal mt-8 flex flex-wrap gap-2 font-mono text-[11px] uppercase tracking-wider">
        <% data.chips.each do |chip| %><span class="border border-text px-2 py-1 text-text"><%= chip %></span><% end %>
      </div>
    <% end %>
    <% if data.ctas.any? %>
      <div class="reveal mt-8 flex flex-wrap items-center gap-3"><%= gl_ctas(data.ctas) %></div>
    <% end %>
    <% case data.items_style %>
    <% when "roles" %>
      <ul class="reveal mt-12 grid rule-t sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        <% gl_roles.each do |role| %>
          <% r = website_fields(role) %>
          <li class="reveal">
            <a href="#<%= role.slug %>" class="group block border-b-2 border-text py-4 sm:border-b-0 sm:border-r-2 sm:pr-5 sm:last:border-r-0 sm:[&:not(:first-child)]:pl-5 lg:[&:not(:first-child)]:pl-5">
              <span class="tag font-mono text-[11px] text-text-muted"><%= r.n %></span>
              <span class="mt-1 flex items-start justify-between gap-2 text-lg font-semibold leading-snug tracking-tight"><%= role.title %><span class="mt-1 shrink-0 transition-transform group-hover:translate-y-1" aria-hidden="true">↓</span></span>
              <span class="mt-0.5 block font-mono text-[11px] uppercase tracking-wider text-text-muted"><%= r.team %></span>
            </a>
          </li>
        <% end %>
      </ul>
    <% when "figures" %>
      <ul class="reveal mt-12 grid rule-t sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        <% data.items.each do |item| %>
          <li class="reveal border-b-2 border-text py-5 sm:border-b-0 sm:border-r-2 sm:pr-5 sm:last:border-r-0 sm:[&:not(:first-child)]:pl-5 lg:[&:not(:first-child)]:pl-5">
            <span class="block text-4xl font-bold tracking-tight md:text-5xl"><%= item.title %></span>
            <span class="mt-1.5 block text-[14.5px] leading-snug text-text-subtle"><%= item.note %></span>
          </li>
        <% end %>
      </ul>
    <% when "capabilities" %>
      <ul class="reveal mt-12 grid rule-t sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        <% data.items.each do |item| %>
          <li class="reveal border-b-2 border-text py-4 sm:border-b-0 sm:border-r-2 sm:pr-5 sm:last:border-r-0 sm:[&:not(:first-child)]:pl-5 lg:[&:not(:first-child)]:pl-5">
            <span class="text-[15px] font-semibold leading-snug"><%= item.title %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>
