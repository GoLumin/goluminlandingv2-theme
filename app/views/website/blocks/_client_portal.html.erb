<%# locals: (data:) -%>
<%# The client app: its heading and standfirst beside the approvals board. %>
<%= gl_section(tone: "ink", id: "client-app") do %>
  <div class="feature-row">
    <div class="feature-copy reveal">
      <%= gl_eyebrow(data.eyebrow) %>
      <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
      <% if data.body.present? %><p class="lede"><%= data.body %></p><% end %>
    </div>
    <div class="feature-media reveal" style="--i:1"><%= render "website/shared/approvals_mock" %></div>
  </div>
<% end %>
