<%# locals: (data:) -%>
<%# Cards in two to four columns, each with a title, a line and a link. %>
<%= gl_section do %>
  <% if data.heading.present? %>
    <div class="section-head reveal">
      <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
      <% if data.body.present? %><p class="lede"><%= website_plain_text(data.body) %></p><% end %>
    </div>
  <% end %>
  <div class="steps<%= " is-two" if data.columns.to_s == "2" %><%= " is-four" if data.columns.to_s == "4" %>" data-stagger>
    <% data.items.each do |item| %>
      <% href = gl_href(item.link) %>
      <div class="step reveal">
        <h3 class="h-4"><%= item.title %></h3>
        <p><%= website_plain_text(item.body) %></p>
        <% if href %><p style="margin-top:12px"><a class="btn-link" href="<%= href %>">Learn more <span class="arrow" aria-hidden="true">→</span></a></p><% end %>
      </div>
    <% end %>
  </div>
<% end %>
