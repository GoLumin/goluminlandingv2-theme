<%# locals: (data:) -%>
<%# Why one team: the three proofs of the loop as step cards under the heading; the diagram's nodes as a line of chips. %>
<%= gl_section(tone: "subtle", id: "loop", rule: true) do %>
  <div class="section-head reveal">
    <%= gl_eyebrow(data.eyebrow) %>
    <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
    <% if data.body.present? %><p class="lede"><%= data.body %></p><% end %>
  </div>
  <div class="steps" data-stagger>
    <% data.proofs.each do |proof| %><div class="step reveal"><h3 class="h-4"><%= proof.title %></h3><p><%= proof.body %></p></div><% end %>
  </div>
  <% if data.nodes.any? %>
    <div class="chips reveal mt-section">
      <% data.nodes.each_with_index do |node, i| %><span class="chip"><%= node.label %></span><% if i < data.nodes.size - 1 %><span class="small" aria-hidden="true">→</span><% end %><% end %>
      <% if data.center_title.present? %><span class="chip" style="background:var(--ink);color:#fff"><%= data.center_title %><% if data.center_note.present? %> · <%= data.center_note %><% end %></span><% end %>
    </div>
  <% end %>
<% end %>
