<%# locals: (data:) -%>
<%# Who signs: the roles, in order, as the tiles of a dark section, with the caption and the link under them. (For the approvals screenshot, add a Media + text block with the accent background above this one.) %>
<% link = gl_href(data.link) %>
<%= gl_section(tone: "ink", id: "control") do %>
  <div class="section-head reveal">
    <%= gl_eyebrow(data.eyebrow) %>
    <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
    <% if data.body.present? %><p class="lede"><%= data.body %></p><% end %>
  </div>
  <div class="tile-grid is-first" data-stagger data-human-gate>
    <% data.roles.each do |role| %>
      <div class="tile reveal">
        <% if role.who.present? %><p class="tile-kicker"><%= role.who %></p><% end %>
        <h3 class="h-4"><%= role.title.to_s.upcase_first %></h3>
        <p><%= role.body %></p>
      </div>
    <% end %>
  </div>
  <% if data.caption.present? || link %>
    <p class="note reveal"><%= data.caption %><% if link && data.link_label.present? %> <a href="<%= link %>"><%= data.link_label %></a><% end %></p>
  <% end %>
<% end %>
