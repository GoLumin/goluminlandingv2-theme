<%# locals: (data:) -%>
<%# Most agencies against us, row by row (the Ad landing pages global's comparison). %>
<% rows = gl_global(:ad_landing).comparison.rows %>
<% them = "Most agencies" %>
<%= gl_section do %>
  <div class="section-head reveal">
    <%= gl_eyebrow(data.eyebrow) %>
    <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
  </div>
  <table class="compare reveal">
    <thead><tr><th scope="col"><span class="sr-only">Question</span></th><th scope="col"><%= them %></th><th scope="col" class="is-us"><%= data.us_label %></th></tr></thead>
    <tbody>
      <% rows.each do |row| %>
        <tr><th scope="row"><%= row.k %></th><td class="is-them" data-label="<%= them %>"><%= row.a %></td><td class="is-us" data-label="<%= data.us_label %>"><%= row.b %></td></tr>
      <% end %>
    </tbody>
  </table>
<% end %>
