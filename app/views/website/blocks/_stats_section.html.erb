<%# locals: (data:) -%>
<%# A row of figures, each with its label. The image of the core block is not drawn. %>
<%= gl_section(tight: true) do %>
  <% if data.heading.present? %>
    <div class="section-head stat-head reveal">
      <h2 class="h-3"><%= gl_heading(data.heading) %></h2>
      <% if data.body.present? %><p class="lede"><%= website_plain_text(data.body) %></p><% end %>
    </div>
  <% end %>
  <div class="stat-row<%= " is-four" if data.stats.size >= 4 %><%= " is-two" if data.stats.size == 2 %>" data-stagger>
    <% data.stats.each do |stat| %>
      <div class="stat reveal"><span class="num"><%= stat.value %></span><p><%= stat.label %></p></div>
    <% end %>
  </div>
<% end %>
