<%# locals: (data:) -%>
<%# One of the thank-you page's variants: the audit's shows by default; forms.js sends the visitor here with ?form=<slug>, and site.js shows the variant for that form instead. %>
<% back = gl_href(data.back_link) %>
<section class="page-hero" data-variant="<%= data.variant %>" data-form="<%= data.form %>" data-title="<%= data.title %>"<% if data.form.present? %> hidden<% end %>>
  <div class="hero-light" aria-hidden="true"></div>
  <%= render "website/shared/hero_photo" %>
  <div class="container">
    <div class="page-hero-inner">
      <%= gl_eyebrow(data.eyebrow) %>
      <h1 class="h-hero"><%= gl_heading(data.heading) %></h1>
      <% if data.lede.present? %><p class="lede"><%= data.lede %></p><% end %>
    </div>
    <% if data.steps.any? %>
      <div class="page-hero-row"><%= render "website/shared/steps", items: data.steps.each_with_index.map { |s, i| [gl_n(i), s.title, s.body] }, h2: true %></div>
    <% end %>
    <% if back %><p style="margin-top:32px"><a href="<%= back %>" class="btn-link" data-back><%= data.back_label.to_s.delete_suffix("→").strip %> <span class="arrow" aria-hidden="true">→</span></a></p><% end %>
  </div>
</section>
