<%# locals: (data:) -%>
<%# The services (the services collection) as three cards under the section's heading, and the tinted line underneath with the block's link (the tracking that sits under all three). %>
<% link = gl_href(data.link) %>
<%= gl_section(tone: data.tone, id: "services") do %>
  <% if data.heading.present? || data.eyebrow.present? %>
    <div class="section-head reveal">
      <%= gl_eyebrow(data.eyebrow) %>
      <% if data.heading.present? %><h2 class="h-2"><%= gl_heading(data.heading) %></h2><% end %>
      <% if data.lede.present? %><p class="lede"><%= data.lede %></p><% end %>
    </div>
  <% end %>
  <div class="service-grid" data-stagger>
    <%= render partial: "website/shared/service_card", collection: gl_services, as: :service %>
  </div>
  <% if link && data.link_label.present? %>
    <div class="service-underline reveal">
      <a class="btn-link" href="<%= link %>" data-cta="services-link"><%= data.link_label.to_s.delete_suffix("→").strip %> <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  <% end %>
<% end %>
