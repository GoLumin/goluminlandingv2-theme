<%# locals: (data:) -%>
<%# The three services (ServiceSystem.astro), from the services collection. %>
<% link = gl_href(data.link) %>
<%= gl_section(tone: data.tone, id: "services") do %>
  <div class="grid items-end gap-6 md:grid-cols-[1fr_auto]">
    <div class="max-w-3xl">
      <%= gl_eyebrow(data.eyebrow, data.eyebrow_n) %>
      <h2 class="reveal display display-lg"><%= gl_heading(data.heading) %></h2>
    </div>
    <% if link %><a href="<%= link %>" class="reveal inline-flex items-center gap-2 font-semibold underline decoration-2 decoration-signal underline-offset-[6px] hover:decoration-text"><%= data.link_label %></a><% end %>
  </div>
  <p class="reveal mt-6 max-w-2xl text-lg leading-snug text-text-subtle"><%= data.lede %></p>
  <div class="mt-12 grid gap-6 lg:grid-cols-3" data-stagger>
    <% gl_services.each do |service| %>
      <%= render "website/shared/service_card", service: %>
    <% end %>
  </div>
<% end %>
