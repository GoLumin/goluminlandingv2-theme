<%# locals: (data:) -%>
<%# Case studies from the work collection: the slugs listed, else the first four; or every one (all: the results page). One case is the feature; the next four are cards; the rest are the small "more of the work" tiles. With all, every case is a feature, alternating sides. %>
<% listed = gl_cases(data.cases) %>
<% studies = data.all ? gl_work : listed.presence || gl_work.first(4) %>
<%= render layout: "website/shared/case_studies", locals: {studies:, eyebrow: data.eyebrow, heading: data.heading, body: data.body, link_label: data.link_label, tone: data.tone, all: data.all} do %>
  <% if data.note.present? %>
    <div class="service-underline reveal" style="margin-top:72px"><p><% if data.note_lead.present? %><strong><%= data.note_lead %></strong> <% end %><%= data.note %></p></div>
  <% end %>
<% end %>
