<%# locals: (data:) -%>
<%# Every published post, newest first: its share card, its date and kicker, its title and summary. %>
<% posts = gl_posts %>
<%= gl_section(tight: true) do %>
  <% if posts.empty? %>
    <p class="lede"><%= data.empty %></p>
  <% else %>
    <ul class="post-list" data-stagger>
      <% posts.each do |post| %>
        <% f = website_fields(post) %>
        <li class="reveal">
          <a href="<%= website_path(post) %>" class="post-row">
            <div>
              <%= gl_image f.share_image, alt: "", sizes: "(min-width: 720px) 18rem, 100vw", loading: :lazy %>
              <p class="small"><time datetime="<%= post.published_at&.iso8601 %>"><%= post.published_at&.strftime("%B %-d, %Y") %></time><% if f.eyebrow.present? %> · <%= f.eyebrow %><% end %></p>
            </div>
            <div>
              <h2 class="h-3"><%= post.title %></h2>
              <% if f.description.present? %><p><%= f.description %></p><% end %>
              <p style="margin-top:12px"><span class="btn-link">Read it <span class="arrow" aria-hidden="true">→</span></span></p>
            </div>
          </a>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
