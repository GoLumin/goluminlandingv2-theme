<%# locals: (data:) -%>
<%# Every published post, newest first (blog/index.astro): its share card, date and kicker, title and summary. %>
<% posts = gl_posts %>
<%= gl_section do %>
  <% if posts.empty? %>
    <p class="text-lg text-text-subtle"><%= data.empty %></p>
  <% else %>
    <ul class="rule-t" data-stagger>
      <% posts.each do |post| %>
        <% f = website_fields(post) %>
        <li class="reveal">
          <a href="<%= website_path(post) %>" class="group grid gap-x-10 gap-y-4 border-b border-border py-8 md:grid-cols-[18rem_1fr]">
            <div>
              <%= gl_image f.share_image, alt: "", sizes: "(min-width: 768px) 18rem, 100vw", class: "block w-full h-auto border-2 border-text transition-shadow group-hover:shadow-[6px_6px_0_0_var(--color-primary)]" %>
              <div class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted">
                <time datetime="<%= post.published_at&.iso8601 %>"><%= post.published_at&.strftime("%B %-d, %Y") %></time>
                <span class="mt-1 block text-primary"><%= f.eyebrow %></span>
              </div>
            </div>
            <div class="max-w-3xl">
              <h2 class="text-2xl font-bold leading-snug tracking-tight group-hover:text-primary md:text-3xl"><%= post.title %></h2>
              <p class="mt-3 text-[16px] leading-snug text-text-subtle"><%= f.description %></p>
              <span class="mt-4 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-text">Read it<span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span></span>
            </div>
          </a>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
