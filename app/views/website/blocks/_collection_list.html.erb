<%# locals: (data:) -%>
<%# Entries of a collection, as the CMS picked them, as linked cards. %>
<% entries = Array(data.resolved.to_h["entries"]) %>
<%= gl_section do %>
  <% if data.heading.present? %><h2 class="reveal display display-lg max-w-3xl"><%= gl_heading(data.heading) %></h2><% end %>
  <% if data.body.present? %><p class="reveal mt-6 max-w-2xl text-lg leading-snug text-text-subtle"><%= website_plain_text(data.body) %></p><% end %>
  <div class="mt-12 grid gap-6 md:grid-cols-3" data-stagger>
    <% entries.each do |entry| %>
      <% summary = website_plain_text(entry.dig("frontmatter", "description").presence || entry["excerpt"]) %>
      <a href="<%= entry["url"] %>" class="reveal lift block border-2 border-text bg-surface p-6">
        <h3 class="text-xl font-bold tracking-tight"><%= website_plain_text(entry["title"]) %></h3>
        <% if summary.present? %><p class="mt-3 text-[15px] leading-snug text-text-subtle"><%= summary.truncate(160) %></p><% end %>
      </a>
    <% end %>
  </div>
<% end %>
