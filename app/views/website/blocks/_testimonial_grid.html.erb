<%# locals: (data:) -%>
<%= gl_section(tone: "subtle") do %>
  <% if data.heading.present? %><h2 class="reveal display display-lg max-w-3xl"><%= gl_heading(data.heading) %></h2><% end %>
  <% if data.body.present? %><p class="reveal mt-6 max-w-2xl text-lg leading-snug text-text-subtle"><%= website_plain_text(data.body) %></p><% end %>
  <div class="mt-12 grid gap-6 md:grid-cols-3" data-stagger>
    <% data.testimonials.each do |t| %>
      <figure class="reveal flex flex-col border-2 border-text bg-surface p-6">
        <% if t.rating.to_i.positive? %><p class="text-primary" aria-label="<%= t.rating %> out of 5"><%= "★" * t.rating.to_i.clamp(0, 5) %></p><% end %>
        <blockquote class="mt-3 text-[16px] font-medium leading-snug"><%= website_plain_text(t.quote) %></blockquote>
        <figcaption class="mt-auto pt-5 font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted"><%= t.attribution %></figcaption>
      </figure>
    <% end %>
  </div>
<% end %>
