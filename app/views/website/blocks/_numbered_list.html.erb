<%# locals: (data:) -%>
<%# The page's argument beside its heading: the plan list. Items are cards on the right; a tagged list shows each tag as its kicker (the worked example's clock), a quoted one puts the titles in quotes. %>
<%= gl_section(tone: data.tone, id: data.anchor) do %>
  <%= render "website/shared/numbered_list", eyebrow: data.eyebrow, eyebrow_n: data.eyebrow_n, heading: data.heading, body: data.body,
    quoted: data.quoted, marker: data.marker, ctas: data.ctas,
    items: data.items.map { |item| [item.title, item.body, item.tag] } %>
<% end %>
