<%# locals: (data:) -%>
<%# The homepage's opening: the Google Partner pill (the chip naming it, with the badge line and link), the headline (a *marked* phrase in violet), the standfirst, the proof line (the other chips, **bold** words allowed), the buttons, and the plan form on the right (under the headline on a phone). The photograph behind it is the theme's. The video and the featured clients of the old hero are not drawn. %>
<% partner, proofs = data.chips.partition { |chip| chip.to_s.match?(/google partner/i) } %>
<% badge = gl_href(data.badge_link) %>
<section class="hero is-night hero-home">
  <%= render "website/shared/scene", key: "/", lamp: ["56%", "66%"] %>
  <div class="container hero-grid">
    <div class="hero-copy">
      <% if partner.any? %>
        <%= content_tag(badge ? :a : :div, class: "hero-badge", href: badge, target: (badge && gl_external?(badge) ? "_blank" : nil), rel: (badge && gl_external?(badge) ? "noopener" : nil), data: {enter: "1", cta: "hero-partner"}) do %>
          <span class="badge-tile"><%= image_tag gl_asset_path("google-partner.svg"), alt: "Google Partner badge", width: 64, height: 61 %></span>
          <span class="badge-text"><strong><%= gl_inline(partner.first) %></strong><% if data.badge_label.present? %><span><%= data.badge_label %></span><% end %></span>
        <% end %>
      <% elsif data.eyebrow.present? %>
        <p class="hero-kicker" data-enter="1"><%= data.eyebrow %></p>
      <% end %>
      <h1 class="h-hero" data-enter="2"><%= gl_heading(data.heading) %></h1>
      <% if data.lede.present? %><p class="lede" data-enter="3"><%= data.lede %></p><% end %>
      <% if data.body.present? %><p class="hero-body" data-enter="3"><%= data.body %></p><% end %>
      <% if proofs.any? %>
        <div class="hero-proof" data-enter="4">
          <% proofs.each do |chip| %><div class="proof"><span><%= gl_inline(chip) %></span></div><% end %>
        </div>
      <% end %>
      <% if data.ctas.any? %><div class="hero-links" data-enter="5"><%= gl_ctas(data.ctas, cta: "hero") %></div><% end %>
    </div>
    <%= render "website/shared/audit_form", prefix: "hero", cta: "hero-form", audit_type: data.audit_type, heading: data.audit_heading, blurb: data.audit_body %>
  </div>
</section>
