<%# locals: (data:) -%>
<%# The record, as figures: each stat with its label and a line about it. %>
<% link = gl_href(data.link) %>
<%= gl_section(tone: "ink") do %>
  <div class="section-head reveal">
    <%= gl_eyebrow(data.eyebrow) %>
    <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
    <% if data.body.present? %><p class="lede"><%= data.body %></p><% end %>
  </div>
  <div class="stat-row<%= " is-four" if data.stats.size >= 4 %>" data-stagger>
    <% data.stats.each do |stat| %>
      <div class="stat reveal"><span class="num"><%= stat.value %></span><p><strong><%= stat.label %></strong></p><% if stat.body.present? %><p class="small"><%= stat.body %></p><% end %></div>
    <% end %>
  </div>
  <% if link && data.link_label.present? %><p class="btn-row" style="margin-top:40px"><a class="btn-link" href="<%= link %>"><%= data.link_label.to_s.delete_suffix("→").strip %> <span class="arrow" aria-hidden="true">→</span></a></p><% end %>
<% end %>
