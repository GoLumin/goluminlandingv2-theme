<%# locals: (data:) -%>
<%# Who you'll talk to: the team collection (photo, name, role, bio), under the Ad landing pages global's heading and standfirst. %>
<% founders = gl_global(:ad_landing).founders %>
<%= gl_section(tone: "subtle", id: "people", rule: true) do %>
  <div class="section-head reveal">
    <%= gl_eyebrow(data.eyebrow) %>
    <h2 class="h-2"><%= gl_heading(founders.heading) %></h2>
    <% if founders.sub.present? %><p class="lede"><%= founders.sub %></p><% end %>
  </div>
  <div class="people-grid" data-stagger>
    <% gl_team.each do |person| %>
      <% p = website_fields(person) %>
      <div class="person reveal">
        <%= gl_image p.photo, alt: person.title, sizes: "7rem", loading: :lazy %>
        <div>
          <h3 class="h-4"><%= person.title %></h3>
          <p class="person-role"><%= p.role %></p>
          <p><%= p.bio %></p>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
