<%# locals: (data:) -%>
<%# Why we're on the banner (laspalmas): the story, the photo of the banner
    and what the sponsorship funds. Converted to the Method vocabulary; the
    block's fields are unchanged. %>
<%= gl_section(id: "why", rule: false) do %>
  <div class="two-col story-split">
    <div>
      <%= gl_eyebrow(data.eyebrow, data.eyebrow_n) %>
      <h2 class="h-2"><%= gl_heading(data.heading) %></h2>
      <% data.body.each do |paragraph| %><p class="lede story-p"><%= paragraph %></p><% end %>
    </div>
    <figure class="story-fig">
      <%= gl_image data.image, sizes: "(min-width: 64rem) 34rem, 100vw", class: "story-img" %>
      <figcaption class="fig-label story-cap"><%= data.caption %></figcaption>
      <div class="callout-box story-funds">
        <p class="card-kicker"><%= data.funds_label %></p>
        <ul class="chips story-chips">
          <% data.funds.each do |fund| %><li class="chip"><%= fund %></li><% end %>
        </ul>
        <%= render "website/shared/inline_markdown", text: data.funds_note, klass: "small story-note" %>
      </div>
    </figure>
  </div>
<% end %>
