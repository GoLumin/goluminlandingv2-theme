<%# locals: (heading:, blurb:) -%>
<%# The closing band the mirror puts at the foot of /story, /services and /work. %>
<section class="section cta-band on-dark">
  <div class="wrap">
    <h2 class="display cta-h"><%= heading %> <span class="signal">&hellip;</span></h2>
    <p class="cta-p"><%= blurb %></p>
    <div class="btn-row">
      <a href="/lets-talk" class="btn btn-primary">Book a diagnostic <span class="arrow">&rarr;</span></a>
      <a href="/services" class="btn btn-ghost">Explore services</a>
    </div>
  </div>
</section>
