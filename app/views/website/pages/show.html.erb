<%# locals: (page:) -%>
<%# Every CMS page, from its blocks. The home page is the one the Method
    reference covers section for section, so it renders from that template
    until its copy moves into CMS blocks. %>
<% content_for :head, gl_seo_tags(page) %>
<% if page.slug == "home" %>
  <%= render "website/pages/method_home" %>
<% else %>
  <% if Array(page.blocks).any? { |block| block.is_a?(Hash) && block["type"].in?(%w[audit_form home_hero closing_form]) } %>
    <% content_for :sticky_cta, "Request an audit" %>
  <% end %>
  <%= website_blocks page %>
<% end %>
