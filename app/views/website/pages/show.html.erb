<%# locals: (page:) -%>
<%# Every CMS page, from its blocks. A page with an audit form gets the phone's sticky audit bar. %>
<% content_for :head, gl_seo_tags(page) %>
<% if Array(page.blocks).any? { |block| block.is_a?(Hash) && block["type"] == "audit_form" } %>
  <% content_for :sticky_cta, "Get a free audit →" %>
<% end %>
<%= website_blocks page %>
