<!DOCTYPE html>
<html lang="<%= website_settings["default_locale"].presence || "en" %>" class="antialiased">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%# The type: Inter, from Google Fonts. The theme's own files come from the theme itself (Goluminlandingv2::AssetsController), not the asset pipeline. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="<%= gl_asset_path("site.css") %>">
    <%= website_design_tags %>
    <%= yield :head %>
    <meta name="theme-color" content="#ffffff">
    <link rel="icon" href="<%= gl_favicon_href %>">
    <link rel="apple-touch-icon" href="<%= gl_asset_path("apple-touch-icon.png") %>">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="sitemap" href="/sitemap.xml">
    <%= website_scripts("head") %>
    <%= gl_javascript_tags %>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <% if content_for?(:header) %>
      <%= yield :header %>
    <% else %>
      <%= render "website/shared/header" %>
    <% end %>
    <main id="main"><%= yield %></main>
    <% if content_for?(:footer) %>
      <%= yield :footer %>
    <% else %>
      <%= render "website/shared/footer" %>
    <% end %>
    <% if content_for?(:sticky_cta) && website_design(:sticky_cta) %>
      <%= render "website/shared/mobile_bar", label: content_for(:sticky_cta) %>
    <% end %>
    <%= website_scripts("body") %>
  </body>
</html>
